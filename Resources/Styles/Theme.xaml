<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    x:Class="MyRoboticsInspector.Resources.Styles.Theme">

    <!--
    ╔══════════════════════════════════════════════════════════════════════╗
    ║  THEME 2.0 — "Deep Field"                                              ║
    ║  Premium dark design system, Windows 11 native (Mica-aware).          ║
    ║  Saha kullanımı için göz yormayan derin koyu yüzeyler; elektrik mavisi ║
    ║  vurgu; yumuşak gölge ile derinlik; hover/press mikro-etkileşimleri.   ║
    ║  Mevcut tüm anahtarlar korunur — sayfalar değişmeden modernleşir.      ║
    ╚══════════════════════════════════════════════════════════════════════╝
    -->

    <!-- ════════ RENK PALETİ ════════ -->
    <!-- Renk anahtarları artık ColorsDark.xaml / ColorsLight.xaml içinde;
         ThemeService çalışma anında hangi paletin yükleneceğini seçer.
         Buradaki fırça/gradyan/stiller bu anahtarları StaticResource ile tüketir. -->

    <!-- ════════ BRUSHES (Shape uyumlu) ════════ -->
    <SolidColorBrush x:Key="BrushPageBg" Color="{DynamicResource ColorPageBg}" />
    <SolidColorBrush x:Key="BrushSurface" Color="{DynamicResource ColorSurface}" />
    <SolidColorBrush x:Key="BrushSurfaceHigh" Color="{DynamicResource ColorSurfaceHigh}" />
    <SolidColorBrush x:Key="BrushBorder" Color="{DynamicResource ColorBorder}" />
    <SolidColorBrush x:Key="BrushAccent" Color="{DynamicResource ColorAccent}" />

    <!-- ════════ GRADIENTS ════════ -->
    <LinearGradientBrush x:Key="GradientAccent" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3D9DFF" Offset="0" />
        <GradientStop Color="#0A84FF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GradientBrand" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0A84FF" Offset="0" />
        <GradientStop Color="#5E5CE6" Offset="0.55" />
        <GradientStop Color="#BF5AF2" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GradientDanger" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF5A4F" Offset="0" />
        <GradientStop Color="#E0352B" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GradientSuccess" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3BDC66" Offset="0" />
        <GradientStop Color="#24B84C" Offset="1" />
    </LinearGradientBrush>

    <!-- Kart tepesine ince ışık vuruşu (derinlik hissi) — temaya duyarlı -->
    <LinearGradientBrush x:Key="GradientSurface" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{DynamicResource ColorSurfaceHigh}" Offset="0" />
        <GradientStop Color="{DynamicResource ColorSurface}" Offset="1" />
    </LinearGradientBrush>

    <!-- Video tuval zemini -->
    <LinearGradientBrush x:Key="GradientVideoVoid" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0D0F14" Offset="0" />
        <GradientStop Color="#050608" Offset="1" />
    </LinearGradientBrush>

    <!-- ════════ SPACING SCALE ════════ -->
    <x:Double x:Key="SpaceXS">4</x:Double>
    <x:Double x:Key="SpaceS">8</x:Double>
    <x:Double x:Key="SpaceM">12</x:Double>
    <x:Double x:Key="SpaceL">16</x:Double>
    <x:Double x:Key="SpaceXL">24</x:Double>
    <x:Double x:Key="Space2XL">32</x:Double>

    <!-- ════════ RADIUS SCALE ════════ -->
    <x:Double x:Key="RadiusInput">10</x:Double>
    <x:Double x:Key="RadiusButton">12</x:Double>
    <x:Double x:Key="RadiusCard">16</x:Double>
    <x:Double x:Key="RadiusPill">22</x:Double>

    <!-- ════════ SHADOWS ════════ -->
    <!-- NOT: MAUI'de Shadow : Element. Tek bir Shadow örneği birden çok view'a
         paylaştırılırsa (stil setter'ı üzerinden) yalnızca sonuncuda görünür.
         Bu yüzden gölge yalnızca TEKİL hero elemanlarda kullanılır; her biri
         aşağıdaki kaynağı yalnızca BİR kez referanslar (ya da inline tanımlanır). -->
    <Shadow x:Key="ShadowDanger" Brush="#FF453A" Offset="0,4" Radius="18" Opacity="0.50" />

    <!-- ════════════════════════════════════════════════════════════════════ -->
    <!--  CARDS                                                                -->
    <!-- ════════════════════════════════════════════════════════════════════ -->

    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Stroke" Value="{DynamicResource ColorBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Background" Value="{StaticResource GradientSurface}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="CardBorderAccent" TargetType="Border" BasedOn="{StaticResource CardBorder}">
        <Setter Property="Stroke" Value="{DynamicResource ColorSuccess}" />
        <Setter Property="StrokeThickness" Value="1.5" />
    </Style>

    <!-- Yarı saydam cam kart (Mica üzerinde) -->
    <Style x:Key="GlassCard" TargetType="Border">
        <Setter Property="Stroke" Value="{DynamicResource ColorBorderStrong}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource ColorSurfaceGlass}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- İnce ayırıcı -->
    <Style x:Key="Divider" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color" Value="{DynamicResource ColorBorderSubtle}" />
    </Style>

    <!-- ════════════════════════════════════════════════════════════════════ -->
    <!--  TYPOGRAPHY SCALE                                                     -->
    <!-- ════════════════════════════════════════════════════════════════════ -->

    <Style x:Key="Display" TargetType="Label">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource ColorTextPrimary}" />
    </Style>

    <Style x:Key="Title" TargetType="Label">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource ColorTextPrimary}" />
    </Style>

    <Style x:Key="Subtitle" TargetType="Label">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{DynamicResource ColorTextSecondary}" />
    </Style>

    <!-- Section title (küçük, harf aralıklı üst başlık) -->
    <Style x:Key="SectionTitle" TargetType="Label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource ColorTextTertiary}" />
        <Setter Property="CharacterSpacing" Value="1.4" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!-- Overline (en küçük etiket) -->
    <Style x:Key="Overline" TargetType="Label">
        <Setter Property="FontSize" Value="9" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource ColorTextTertiary}" />
        <Setter Property="CharacterSpacing" Value="1.6" />
    </Style>

    <Style x:Key="CardTitle" TargetType="Label">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource ColorTextPrimary}" />
    </Style>

    <Style x:Key="BodyText" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{DynamicResource ColorTextPrimary}" />
    </Style>

    <Style x:Key="Caption" TargetType="Label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextColor" Value="{DynamicResource ColorTextSecondary}" />
    </Style>

    <!-- İkon (Segoe Fluent / MDL2 glyph) etiketi. Windows sistem fontu — kayıt gerekmez. -->
    <Style x:Key="Glyph" TargetType="Label">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="TextColor" Value="{DynamicResource ColorTextPrimary}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- ════════════════════════════════════════════════════════════════════ -->
    <!--  BUTTONS — hover/press mikro-etkileşimli                              -->
    <!-- ════════════════════════════════════════════════════════════════════ -->

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorAccent}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HeightRequest" Value="46" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="1" />
                            <Setter Property="Opacity" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="1.025" />
                            <Setter Property="Opacity" Value="0.92" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="0.97" />
                            <Setter Property="Opacity" Value="0.85" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.4" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorSuccess}" />
        <Setter Property="TextColor" Value="#06210E" />
    </Style>

    <Style x:Key="WarningButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorWarning}" />
        <Setter Property="TextColor" Value="#3A2400" />
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorDanger}" />
        <Setter Property="TextColor" Value="White" />
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorSurfaceHigh}" />
        <Setter Property="TextColor" Value="{DynamicResource ColorTextPrimary}" />
        <Setter Property="BorderColor" Value="{DynamicResource ColorBorderStrong}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="HeightRequest" Value="42" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontAttributes" Value="None" />
    </Style>

    <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource ColorTextSecondary}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="HeightRequest" Value="36" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontAttributes" Value="None" />
    </Style>

    <!-- Sticky acil durdurma — gradient + güçlü kırmızı gölge -->
    <Style x:Key="EmergencyStopButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource GradientDanger}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="HeightRequest" Value="58" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="Shadow" Value="{StaticResource ShadowDanger}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="1.02" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="0.96" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Yuvarlak ikon buton (40x40) -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorSurfaceHigh}" />
        <Setter Property="TextColor" Value="{DynamicResource ColorTextPrimary}" />
        <Setter Property="BorderColor" Value="{DynamicResource ColorBorderStrong}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="WidthRequest" Value="42" />
        <Setter Property="HeightRequest" Value="42" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="1.06" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="0.92" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- ════════════════════════════════════════════════════════════════════ -->
    <!--  CHIPS & BADGES                                                       -->
    <!-- ════════════════════════════════════════════════════════════════════ -->

    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Stroke" Value="{DynamicResource ColorBorderStrong}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
        <Setter Property="Background" Value="{DynamicResource ColorSurfaceHigh}" />
        <Setter Property="Padding" Value="12,6" />
    </Style>

    <Style x:Key="ChipAccent" TargetType="Border" BasedOn="{StaticResource Chip}">
        <Setter Property="Stroke" Value="{DynamicResource ColorAccent}" />
        <Setter Property="Background" Value="{DynamicResource ColorAccentMuted}" />
    </Style>

    <!-- Küçük durum rozeti (pill) -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="Background" Value="{DynamicResource ColorAccentMuted}" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="HorizontalOptions" Value="Start" />
    </Style>

    <!-- ════════════════════════════════════════════════════════════════════ -->
    <!--  FORM INPUTS                                                          -->
    <!-- ════════════════════════════════════════════════════════════════════ -->

    <Style TargetType="Entry">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorSurfaceHigh}" />
        <Setter Property="TextColor" Value="{DynamicResource ColorTextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource ColorTextTertiary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HeightRequest" Value="42" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorSurfaceHigh}" />
        <Setter Property="TextColor" Value="{DynamicResource ColorTextPrimary}" />
        <Setter Property="TitleColor" Value="{DynamicResource ColorTextTertiary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HeightRequest" Value="42" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorSurfaceHigh}" />
        <Setter Property="TextColor" Value="{DynamicResource ColorTextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource ColorTextTertiary}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorSurfaceHigh}" />
        <Setter Property="TextColor" Value="{DynamicResource ColorTextPrimary}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style TargetType="TimePicker">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorSurfaceHigh}" />
        <Setter Property="TextColor" Value="{DynamicResource ColorTextPrimary}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

</ResourceDictionary>
