<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MyRoboticsInspector.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MyRoboticsInspector"
    xmlns:pages="clr-namespace:MyRoboticsInspector.Pages"
    Title="MyRoboticsInspector"
    FlyoutBehavior="Flyout"
    FlyoutWidth="280"
    FlyoutBackgroundColor="{StaticResource ColorFlyoutBg}"
    BackgroundColor="{StaticResource ColorSurfaceSubtle}"
    Shell.BackgroundColor="{StaticResource ColorSurfaceSubtle}"
    Shell.ForegroundColor="{StaticResource ColorAccentSoft}"
    Shell.TitleColor="{StaticResource ColorTextPrimary}"
    Shell.DisabledColor="{StaticResource ColorTextTertiary}"
    Shell.UnselectedColor="{StaticResource ColorTextSecondary}">

    <!-- ════════ SIDEBAR ÖĞE ŞABLONU — ikon + seçili pill (VSM) ════════ -->
    <Shell.ItemTemplate>
        <DataTemplate>
            <Grid Padding="10,2">
                <Border x:Name="Pill"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="Transparent"
                        Padding="12,11">
                    <Grid ColumnDefinitions="26,*" ColumnSpacing="14">
                        <Label x:Name="Icon" Grid.Column="0"
                               FontFamily="Segoe MDL2 Assets"
                               Text="{Binding Title, Converter={StaticResource NavGlyph}}"
                               FontSize="17"
                               TextColor="{StaticResource ColorTextTertiary}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                        <Label x:Name="TitleLabel" Grid.Column="1"
                               Text="{Binding Title}"
                               TextColor="{StaticResource ColorTextSecondary}"
                               FontSize="14"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter TargetName="Pill" Property="Border.BackgroundColor" Value="{StaticResource ColorSurfaceHigh}" />
                                    <Setter TargetName="TitleLabel" Property="Label.TextColor" Value="{StaticResource ColorTextPrimary}" />
                                    <Setter TargetName="Icon" Property="Label.TextColor" Value="{StaticResource ColorTextPrimary}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Selected">
                                <VisualState.Setters>
                                    <Setter TargetName="Pill" Property="Border.BackgroundColor" Value="{StaticResource ColorAccent}" />
                                    <Setter TargetName="Icon" Property="Label.TextColor" Value="#FFFFFF" />
                                    <Setter TargetName="TitleLabel" Property="Label.TextColor" Value="#FFFFFF" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
            </Grid>
        </DataTemplate>
    </Shell.ItemTemplate>

    <!-- ════════ HEADER — gradient logo işareti + marka ════════ -->
    <Shell.FlyoutHeader>
        <Grid Padding="20,26,20,18" RowDefinitions="Auto,Auto" RowSpacing="16">
            <Grid Grid.Row="0" ColumnDefinitions="46,*" ColumnSpacing="13">
                <!-- Logo mark -->
                <Border Grid.Column="0"
                        WidthRequest="46" HeightRequest="46"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 13"
                        Background="{StaticResource GradientBrand}">
                    <Label Text="&#xE714;" FontFamily="Segoe MDL2 Assets"
                           FontSize="22" TextColor="White"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label Text="My Robotics" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource ColorTextPrimary}" />
                    <Label Text="Kanal Görüntüleme Sistemi" FontSize="10.5" TextColor="{StaticResource ColorTextTertiary}" />
                </VerticalStackLayout>
            </Grid>

            <!-- Standart rozeti -->
            <Border Grid.Row="1"
                    StrokeThickness="0" StrokeShape="RoundRectangle 8"
                    Background="{StaticResource ColorAccentMuted}" Padding="10,5"
                    HorizontalOptions="Start">
                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="7">
                    <Label Grid.Column="0" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                           FontSize="11" TextColor="{StaticResource ColorAccentSoft}" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="EN 13508-2:2003+A1:2011"
                           FontSize="10" TextColor="{StaticResource ColorAccentSoft}" VerticalOptions="Center" />
                </Grid>
            </Border>
        </Grid>
    </Shell.FlyoutHeader>

    <!-- ════════ NAVİGASYON ════════ -->
    <FlyoutItem Title="Kontrol Paneli">
        <ShellContent ContentTemplate="{DataTemplate local:MainPage}" Route="live" />
    </FlyoutItem>

    <FlyoutItem Title="Projeler">
        <ShellContent ContentTemplate="{DataTemplate pages:ProjectsPage}" Route="projects" />
    </FlyoutItem>

    <FlyoutItem Title="İncelemeler">
        <ShellContent ContentTemplate="{DataTemplate pages:InspectionsPage}" Route="inspections" />
    </FlyoutItem>

    <FlyoutItem Title="Müşteriler">
        <ShellContent ContentTemplate="{DataTemplate pages:CustomersPage}" Route="customers" />
    </FlyoutItem>

    <FlyoutItem Title="Ayarlar">
        <ShellContent ContentTemplate="{DataTemplate pages:SettingsPage}" Route="settings" />
    </FlyoutItem>

    <!-- ════════ FOOTER — operatör + bulut durumu + oturum ════════ -->
    <Shell.FlyoutFooter>
        <VerticalStackLayout Spacing="0" Padding="0,0,0,4">
            <BoxView HeightRequest="1" Color="{StaticResource ColorBorder}" />

            <!-- Aktif operatör kartı -->
            <Grid x:Name="OperatorRow" Padding="16,12,16,4" ColumnDefinitions="Auto,*" ColumnSpacing="10"
                  IsVisible="False">
                <Border Grid.Column="0" StrokeThickness="1.2" Stroke="{StaticResource ColorGold}"
                        StrokeShape="RoundRectangle 18" HeightRequest="36" WidthRequest="36"
                        Background="{StaticResource ColorGoldMuted}">
                    <Label x:Name="OperatorAvatar" Text="?" FontSize="13" FontAttributes="Bold"
                           TextColor="{StaticResource ColorGold}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                    <Label x:Name="OperatorNameLabel" Text="" FontSize="13" FontAttributes="Bold"
                           TextColor="{StaticResource ColorTextPrimary}" LineBreakMode="TailTruncation" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                        <Ellipse x:Name="CloudDot" Grid.Column="0" WidthRequest="8" HeightRequest="8"
                                 Fill="#7E828F" VerticalOptions="Center" />
                        <Label x:Name="CloudStatusLabel" Grid.Column="1" Text="Bulut yedek kapalı"
                               FontSize="10.5" TextColor="{StaticResource ColorTextTertiary}"
                               VerticalOptions="Center" LineBreakMode="TailTruncation" />
                    </Grid>
                </VerticalStackLayout>
            </Grid>

            <Grid Padding="16,8,16,14" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <Button Grid.Column="0"
                        x:Name="SwitchProfileButton"
                        Text="⇄ Profil"
                        Clicked="OnSwitchProfileClicked"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource ColorTextSecondary}"
                        BorderColor="{StaticResource ColorBorder}"
                        BorderWidth="1"
                        CornerRadius="9"
                        FontSize="12.5"
                        HeightRequest="36"
                        Padding="12,0"
                        IsVisible="False" />
                <Button Grid.Column="1"
                        Text="Çıkış"
                        Clicked="OnExitClicked"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource ColorTextSecondary}"
                        BorderColor="{StaticResource ColorBorder}"
                        BorderWidth="1"
                        CornerRadius="9"
                        FontSize="12.5"
                        HeightRequest="36"
                        HorizontalOptions="Start"
                        Padding="12,0" />
                <Label Grid.Column="2"
                       x:Name="VersionLabel"
                       Text=""
                       FontSize="10.5"
                       TextColor="{StaticResource ColorTextTertiary}"
                       VerticalOptions="Center" />
            </Grid>
        </VerticalStackLayout>
    </Shell.FlyoutFooter>

</Shell>
