<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MyRoboticsInspector.ViewModels"
             xmlns:m="clr-namespace:MyRoboticsInspector.Models"
             xmlns:services="clr-namespace:MyRoboticsInspector.Services"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             x:Class="MyRoboticsInspector.MainPage"
             x:DataType="vm:LiveViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource ColorPageBg}">

    <Grid Padding="12" RowDefinitions="*,Auto" ColumnDefinitions="*,300" ColumnSpacing="12">

        <!-- ============== VIDEO + OVERLAY ============== -->
        <Grid Grid.Row="0" Grid.Column="0" x:Name="VideoContainer">
            <Border Stroke="{StaticResource ColorBorder}" StrokeThickness="1"
                    Background="{StaticResource GradientVideoVoid}" StrokeShape="RoundRectangle 14">
                <Border.Shadow>
                    <Shadow Brush="#000000" Offset="0,10" Radius="28" Opacity="0.55" />
                </Border.Shadow>
                <Grid>
                    <!-- Canlı kamera: SkiaSharp composite kare.
                         Proje/adres/baca/metre overlay'i kareye SENKRON gömülü (canlı=kayıt). -->
                    <skia:SKCanvasView x:Name="VideoCanvas"
                                       IsVisible="{Binding HasLiveFrame}" />

                    <!-- Yayın yokken placeholder -->
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="14"
                                         IsVisible="{Binding HasLiveFrame, Converter={StaticResource InvertedBool}}">
                        <Border WidthRequest="92" HeightRequest="92" HorizontalOptions="Center"
                                StrokeThickness="1" Stroke="#2A2C36"
                                StrokeShape="RoundRectangle 46" Background="#12141B">
                            <Label Text="&#xE714;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="40" TextColor="{StaticResource ColorAccentSoft}"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="Kamera görüntüsü bekleniyor"
                               TextColor="White" FontSize="18" FontAttributes="Bold"
                               HorizontalOptions="Center" />
                        <Label Text="Sağ panelden “Yeniden Bağlan” düğmesine dokunun"
                               TextColor="#8A8F9C" FontSize="13"
                               HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                        <Label Text="{Binding StatusMessage}"
                               TextColor="{StaticResource ColorWarning}" FontSize="12"
                               HorizontalOptions="Center" HorizontalTextAlignment="Center"
                               IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmpty}}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- CANLI SENSÖR ŞERİDİ — operatör farkındalığı (kayda GÖMÜLMEZ).
                 Proje/adres/baca/metre/saat/REC artık composite kareye SENKRON gömülü. -->
            <VerticalStackLayout Padding="18" Spacing="2" InputTransparent="True"
                                 HorizontalOptions="End" VerticalOptions="End"
                                 IsVisible="{Binding HasLiveFrame}">
                <Label Text="{Binding Telemetry.TiltDegrees, StringFormat='Eğim: {0:0.0}°', TargetNullValue=''}"
                       TextColor="White" FontSize="12" HorizontalOptions="End" />
                <Label Text="{Binding Telemetry.PressureBar, StringFormat='Basınç: {0:0.0} bar', TargetNullValue=''}"
                       TextColor="White" FontSize="12" HorizontalOptions="End" />
                <Label Text="{Binding Telemetry.TemperatureC, StringFormat='Sıcaklık: {0:0.0}°C', TargetNullValue=''}"
                       TextColor="White" FontSize="12" HorizontalOptions="End" />
                <Label Text="{Binding Telemetry.BatteryPercent, StringFormat='Batarya: {0:0}%', TargetNullValue=''}"
                       TextColor="White" FontSize="12" HorizontalOptions="End" />
                <Label Text="⚠ GAZ" TextColor="{StaticResource ColorDanger}" FontSize="14" FontAttributes="Bold" HorizontalOptions="End"
                       IsVisible="{Binding Telemetry.GasAlarm}" />
                <Label Text="⚠ SU" TextColor="Aqua" FontSize="14" FontAttributes="Bold" HorizontalOptions="End"
                       IsVisible="{Binding Telemetry.WaterAlarm}" />
            </VerticalStackLayout>
        </Grid>

        <!-- ============== RIGHT PANEL ============== -->
        <ScrollView Grid.Row="0" Grid.Column="1">
            <VerticalStackLayout Spacing="10">

                    <!-- ============== DEFECT MINI-LIST ============== -->
                    <Border Style="{StaticResource CardBorder}"
                            IsVisible="{Binding IsInspecting}">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="EKLENEN KUSURLAR" Style="{StaticResource SectionTitle}" />
                            <CollectionView ItemsSource="{Binding ActiveDefects}"
                                            MaximumHeightRequest="220"
                                            SelectionMode="None">
                                <CollectionView.EmptyView>
                                    <Label Text="Henüz kusur yok"
                                           Style="{StaticResource Caption}" HorizontalOptions="Center" />
                                </CollectionView.EmptyView>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="m:Defect">
                                        <Border Padding="6" Margin="0,0,0,4"
                                                Stroke="{StaticResource ColorBorder}" StrokeThickness="1"
                                                StrokeShape="RoundRectangle 6"
                                                Background="{StaticResource ColorSurfaceHigh}">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LiveViewModel}}, Path=PreviewDefectAtCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Grid ColumnDefinitions="50,*,Auto" ColumnSpacing="6">
                                                <Image Grid.Column="0" Source="{Binding PhotoPath}"
                                                       HeightRequest="36" WidthRequest="50"
                                                       Aspect="AspectFill" BackgroundColor="#222" />
                                                <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                                    <Label TextColor="White" FontSize="12" FontAttributes="Bold">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Text="{Binding IskiCode, TargetNullValue=''}" TextColor="{StaticResource ColorWarning}" />
                                                                <Span Text="  " />
                                                                <Span Text="{Binding Type}" />
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                    <Label Style="{StaticResource Caption}" FontSize="10">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Text="{Binding DistanceMeters, StringFormat='{0:0.0} m', TargetNullValue='— m'}" />
                                                                <Span Text="  •  " TextColor="{StaticResource ColorTextTertiary}" />
                                                                <Span Text="{Binding VideoTimestampMs, Converter={StaticResource MsToTimestamp}}" />
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                </VerticalStackLayout>
                                                <Button Grid.Column="2" Text="🗑"
                                                        Style="{StaticResource QuietButton}"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LiveViewModel}}, Path=DeleteDefectCommand}"
                                                        CommandParameter="{Binding .}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                    <!-- ============== KAMERA + KAYIT ============== -->
                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="KAMERA" Style="{StaticResource SectionTitle}" />
                            <!-- Yayın aktifken: sadece durdur butonu; kopunca: yeniden bağlan -->
                            <Button Text="⏹ Yayını Durdur"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding StopStreamCommand}"
                                    IsVisible="{Binding IsStreaming}" />
                            <Button Text="🔄 Yeniden Bağlan"
                                    Style="{StaticResource WarningButton}"
                                    Command="{Binding StartStreamCommand}"
                                    IsVisible="{Binding IsStreaming, Converter={StaticResource InvertedBool}}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <Button Grid.Column="0"
                                        Text="{Binding IsRecording, Converter={StaticResource BoolToRecordText}}"
                                        Style="{StaticResource DangerButton}"
                                        BackgroundColor="{Binding IsRecording, Converter={StaticResource BoolToRecordColor}}"
                                        Command="{Binding ToggleRecordingCommand}" />
                                <Button Grid.Column="1" Text="📷"
                                        Style="{StaticResource SecondaryButton}"
                                        WidthRequest="48" Padding="0"
                                        Command="{Binding SnapshotCommand}" />
                            </Grid>
                            <!-- Son kayıt izle / klasör aç -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6"
                                  IsVisible="{Binding HasLastRecording}">
                                <Button Grid.Column="0" Text="▶ Son Kaydı İzle"
                                        Style="{StaticResource PrimaryButton}"
                                        Command="{Binding OpenLastRecordingCommand}" />
                                <Button Grid.Column="1" Text="📁"
                                        Style="{StaticResource SecondaryButton}"
                                        WidthRequest="48" Padding="0"
                                        ToolTipProperties.Text="Kayıt klasörünü aç"
                                        Command="{Binding OpenRecordingsFolderCommand}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- ============== MQTT TRAFFIC LOG ============== -->
                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <Label Grid.Column="0" Text="MQTT LOG" Style="{StaticResource SectionTitle}"
                                       VerticalOptions="Center" />
                                <Button Grid.Column="1" Text="🗑"
                                        Style="{StaticResource QuietButton}" Padding="8,4"
                                        Command="{Binding ClearMqttLogCommand}"
                                        IsVisible="{Binding ShowMqttLog}"
                                        ToolTipProperties.Text="Temizle" />
                                <Button Grid.Column="2"
                                        Text="{Binding ShowMqttLog, Converter={StaticResource BoolToGamepadButtonText}}"
                                        Style="{StaticResource QuietButton}" Padding="8,4"
                                        Command="{Binding ToggleMqttLogCommand}" />
                            </Grid>

                            <!-- Bağlantı durumu satırı -->
                            <Label FontSize="11">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Broker  " TextColor="#888" />
                                        <Span Text="{Binding IsRobotConnected, Converter={StaticResource BoolToConnectionText}}"
                                              TextColor="{Binding IsRobotConnected, Converter={StaticResource BoolToConnectionColor}}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <!-- Log listesi (aç/kapat) -->
                            <Border Background="#0d0d0d" StrokeThickness="0" StrokeShape="RoundRectangle 6"
                                    Padding="0" IsVisible="{Binding ShowMqttLog}">
                                <CollectionView ItemsSource="{Binding MqttLog}"
                                                HeightRequest="260"
                                                VerticalScrollBarVisibility="Always">
                                    <CollectionView.EmptyView>
                                        <Label Text="Henüz mesaj yok — broker'a bağlan"
                                               TextColor="#555" FontSize="11"
                                               HorizontalOptions="Center" Margin="0,16" />
                                    </CollectionView.EmptyView>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="services:MqttLogEntry">
                                            <Grid Padding="8,4" ColumnDefinitions="56,70,*" ColumnSpacing="6"
                                                  RowDefinitions="Auto,Auto">
                                                <!-- Zaman -->
                                                <Label Grid.Row="0" Grid.Column="0"
                                                       Text="{Binding TimeStr}"
                                                       FontSize="9" TextColor="#555"
                                                       VerticalOptions="Start" />
                                                <!-- Yön etiketi -->
                                                <Label Grid.Row="0" Grid.Column="1"
                                                       Text="{Binding Label}"
                                                       FontSize="10" FontAttributes="Bold"
                                                       VerticalOptions="Start">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label"
                                                                     Binding="{Binding Direction}"
                                                                     Value="TX">
                                                            <Setter Property="TextColor" Value="#4fc3f7" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label"
                                                                     Binding="{Binding Direction}"
                                                                     Value="RX">
                                                            <Setter Property="TextColor" Value="#81c784" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label"
                                                                     Binding="{Binding Direction}"
                                                                     Value="Info">
                                                            <Setter Property="TextColor" Value="#ffcc66" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label"
                                                                     Binding="{Binding Direction}"
                                                                     Value="Error">
                                                            <Setter Property="TextColor" Value="#ef5350" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                                <!-- Topic -->
                                                <Label Grid.Row="0" Grid.Column="2"
                                                       Text="{Binding Topic}"
                                                       FontSize="9" TextColor="#888"
                                                       LineBreakMode="TailTruncation"
                                                       VerticalOptions="Start" />
                                                <!-- Payload -->
                                                <Label Grid.Row="1" Grid.ColumnSpan="3"
                                                       Text="{Binding Payload}"
                                                       FontSize="11" TextColor="#ddd"
                                                       FontFamily="OpenSansRegular"
                                                       LineBreakMode="TailTruncation"
                                                       Margin="0,0,0,4" />
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <!-- ============== JOYSTICK + MANUEL ============== -->
                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="GİRDİ" Style="{StaticResource SectionTitle}"
                                       VerticalOptions="Center" />
                                <Button Grid.Column="1"
                                        Text="{Binding IsGamepadActive, Converter={StaticResource BoolToGamepadButtonText}}"
                                        Style="{StaticResource QuietButton}"
                                        Command="{Binding ToggleGamepadCommand}" />
                            </Grid>
                            <Label Text="{Binding GamepadStatusText}" Style="{StaticResource Caption}" />

                            <!-- Joystick anlık girdi göstergesi -->
                            <Border Background="#111" StrokeThickness="0" StrokeShape="RoundRectangle 6"
                                    Padding="10,8"
                                    IsVisible="{Binding IsGamepadConnected}">
                                <VerticalStackLayout Spacing="4">
                                    <!-- Butonlar -->
                                    <Label Text="BUTONLAR" Style="{StaticResource SectionTitle}" FontSize="9" />
                                    <Label Text="{Binding GamepadButtons}"
                                           TextColor="#ffcc66" FontSize="13" FontAttributes="Bold"
                                           FontFamily="OpenSansRegular" />

                                    <!-- Sol stick -->
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,4,0,0">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="SOL STICK" Style="{StaticResource SectionTitle}" FontSize="9" />
                                            <Label FontSize="11" TextColor="White">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="X " TextColor="#888" />
                                                        <Span Text="{Binding GamepadLX, StringFormat='{0:+0.00;-0.00; 0.00}'}"
                                                              TextColor="{StaticResource ColorHighlight}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <Label FontSize="11" TextColor="White">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="Y " TextColor="#888" />
                                                        <Span Text="{Binding GamepadLY, StringFormat='{0:+0.00;-0.00; 0.00}'}"
                                                              TextColor="{StaticResource ColorHighlight}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </VerticalStackLayout>

                                        <!-- Sağ stick -->
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="SAĞ STICK" Style="{StaticResource SectionTitle}" FontSize="9" />
                                            <Label FontSize="11" TextColor="White">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="X " TextColor="#888" />
                                                        <Span Text="{Binding GamepadRX, StringFormat='{0:+0.00;-0.00; 0.00}'}"
                                                              TextColor="{StaticResource ColorHighlight}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <Label FontSize="11" TextColor="White">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="Y " TextColor="#888" />
                                                        <Span Text="{Binding GamepadRY, StringFormat='{0:+0.00;-0.00; 0.00}'}"
                                                              TextColor="{StaticResource ColorHighlight}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </VerticalStackLayout>
                                    </Grid>

                                    <!-- Tetikleyiciler -->
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,4,0,0">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="LT" Style="{StaticResource SectionTitle}" FontSize="9" />
                                            <ProgressBar Progress="{Binding GamepadLT}"
                                                         ProgressColor="{StaticResource ColorWarning}"
                                                         HeightRequest="6" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="RT" Style="{StaticResource SectionTitle}" FontSize="9" />
                                            <ProgressBar Progress="{Binding GamepadRT}"
                                                         ProgressColor="{StaticResource ColorWarning}"
                                                         HeightRequest="6" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Manuel sürüş: klavye (W/A/S/D veya ok tuşları) + dpad (basılı tut) -->
                            <Label Style="{StaticResource Caption}" Margin="0,4,0,0">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Manuel sürüş — " />
                                        <Span Text="W A S D" TextColor="{StaticResource ColorAccentSoft}" FontAttributes="Bold" />
                                        <Span Text=" / ok tuşları" />
                                        <Span Text="  •  görüntüye tıkla, sonra tuşlarla sür" TextColor="{StaticResource ColorTextTertiary}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Grid ColumnDefinitions="*,*,*" RowDefinitions="44,44,44"
                                  ColumnSpacing="4" RowSpacing="4">
                                <Button Grid.Row="0" Grid.Column="1" Text="▲" FontSize="18"
                                        Style="{StaticResource SecondaryButton}">
                                    <Button.GestureRecognizers>
                                        <PointerGestureRecognizer
                                            PointerPressedCommand="{Binding PressForwardCommand}"
                                            PointerReleasedCommand="{Binding ReleaseDpadCommand}"
                                            PointerExitedCommand="{Binding ReleaseDpadCommand}" />
                                    </Button.GestureRecognizers>
                                </Button>
                                <Button Grid.Row="1" Grid.Column="0" Text="◀" FontSize="18"
                                        Style="{StaticResource SecondaryButton}">
                                    <Button.GestureRecognizers>
                                        <PointerGestureRecognizer
                                            PointerPressedCommand="{Binding PressLeftCommand}"
                                            PointerReleasedCommand="{Binding ReleaseDpadCommand}"
                                            PointerExitedCommand="{Binding ReleaseDpadCommand}" />
                                    </Button.GestureRecognizers>
                                </Button>
                                <Button Grid.Row="1" Grid.Column="1" Text="■" FontSize="18"
                                        BackgroundColor="{StaticResource ColorDanger}" TextColor="White"
                                        CornerRadius="8"
                                        Command="{Binding ReleaseDpadCommand}" />
                                <Button Grid.Row="1" Grid.Column="2" Text="▶" FontSize="18"
                                        Style="{StaticResource SecondaryButton}">
                                    <Button.GestureRecognizers>
                                        <PointerGestureRecognizer
                                            PointerPressedCommand="{Binding PressRightCommand}"
                                            PointerReleasedCommand="{Binding ReleaseDpadCommand}"
                                            PointerExitedCommand="{Binding ReleaseDpadCommand}" />
                                    </Button.GestureRecognizers>
                                </Button>
                                <Button Grid.Row="2" Grid.Column="1" Text="▼" FontSize="18"
                                        Style="{StaticResource SecondaryButton}">
                                    <Button.GestureRecognizers>
                                        <PointerGestureRecognizer
                                            PointerPressedCommand="{Binding PressBackwardCommand}"
                                            PointerReleasedCommand="{Binding ReleaseDpadCommand}"
                                            PointerExitedCommand="{Binding ReleaseDpadCommand}" />
                                    </Button.GestureRecognizers>
                                </Button>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>

        <!-- ============== STATUS BAR (full width) ============== -->
        <Border Grid.Row="1" Grid.ColumnSpan="2"
                Background="{StaticResource ColorSurface}"
                Stroke="{StaticResource ColorBorder}" StrokeThickness="1"
                StrokeShape="RoundRectangle 6"
                Padding="12,6" Margin="0,10,0,0">
            <Label Text="{Binding StatusMessage}" Style="{StaticResource BodyText}" FontSize="12" />
        </Border>

        <!-- ============== DEFECT ADD MODAL ============== -->
        <Border Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="2"
                IsVisible="{Binding IsMarkingDefect}"
                Background="#dd000000" Padding="24">
            <ScrollView>
                <VerticalStackLayout Spacing="12" MaximumWidthRequest="720" HorizontalOptions="Center">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Kusur Ekle" FontSize="22" FontAttributes="Bold" TextColor="White" />
                        <Button Grid.Column="1" Text="✕" Padding="14,6"
                                Style="{StaticResource QuietButton}"
                                Command="{Binding CancelDefectCommand}" />
                    </Grid>

                    <Image Source="{Binding EditingDefectSnapshotPath}"
                           HeightRequest="220" Aspect="AspectFit" BackgroundColor="#222" />

                    <!-- İSKİ quick-pick chips -->
                    <Label Text="İSKİ HIZLI KOD" Style="{StaticResource SectionTitle}" />
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding IskiCodes}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="m:IskiDefectCode">
                                    <Border Stroke="{StaticResource ColorBorderStrong}" StrokeThickness="1"
                                            StrokeShape="RoundRectangle 14"
                                            Background="{StaticResource ColorSurfaceHigh}"
                                            Padding="10,5">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LiveViewModel}}, Path=ApplyIskiCodeCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Label FontSize="12" TextColor="White">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Code}" TextColor="{StaticResource ColorWarning}" FontAttributes="Bold" />
                                                    <Span Text="  " />
                                                    <Span Text="{Binding Title}" TextColor="{StaticResource ColorTextSecondary}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Mesafe (m)" Style="{StaticResource Caption}" />
                            <Entry Text="{Binding EditingDefect.DistanceMeters}" Keyboard="Numeric" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Video Zamanı (ms)" Style="{StaticResource Caption}" />
                            <Entry Text="{Binding EditingDefect.VideoTimestampMs}" Keyboard="Numeric" IsReadOnly="True" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Şiddet" Style="{StaticResource Caption}" />
                            <Picker ItemsSource="{Binding SeverityOptions}"
                                    SelectedItem="{Binding EditingDefect.Severity}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Tür" Style="{StaticResource Caption}" />
                            <Picker ItemsSource="{Binding DefectTypes}"
                                    SelectedItem="{Binding EditingDefect.Type}" />
                        </VerticalStackLayout>
                    </Grid>

                    <VerticalStackLayout>
                        <Label Text="Açıklama" Style="{StaticResource Caption}" />
                        <Editor Text="{Binding EditingDefect.Description}" HeightRequest="100"
                                Placeholder="Detay, konum, gözlem..." />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,10,0,0">
                        <Button Grid.Column="0" Text="İptal"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding CancelDefectCommand}" />
                        <Button Grid.Column="1" Text="Kaydet"
                                Style="{StaticResource SuccessButton}"
                                Command="{Binding SaveDefectCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </ScrollView>
        </Border>

        <!-- ============== DEFECT PREVIEW OVERLAY ============== -->
        <Border Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="2"
                IsVisible="{Binding IsPreviewingDefect}"
                Background="#dd000000" Padding="24">
            <VerticalStackLayout Spacing="12" MaximumWidthRequest="720" HorizontalOptions="Center">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="Kusur Önizleme" FontSize="22" FontAttributes="Bold" TextColor="White" />
                    <Button Grid.Column="1" Text="✕" Padding="14,6"
                            Style="{StaticResource QuietButton}"
                            Command="{Binding ClosePreviewCommand}" />
                </Grid>
                <Image Source="{Binding PreviewDefect.PhotoPath}"
                       HeightRequest="380" Aspect="AspectFit" BackgroundColor="#222" />
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="Şiddet" Style="{StaticResource Caption}" />
                        <Label Text="{Binding PreviewDefect.Severity}" Style="{StaticResource CardTitle}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1">
                        <Label Text="Mesafe" Style="{StaticResource Caption}" />
                        <Label Text="{Binding PreviewDefect.DistanceMeters, StringFormat='{0:0.0} m', TargetNullValue='—'}"
                               Style="{StaticResource CardTitle}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2">
                        <Label Text="Video Zamanı" Style="{StaticResource Caption}" />
                        <Label Text="{Binding PreviewDefect.VideoTimestampMs, Converter={StaticResource MsToTimestamp}}"
                               Style="{StaticResource CardTitle}" />
                    </VerticalStackLayout>
                </Grid>
                <Label FontSize="15" FontAttributes="Bold">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding PreviewDefect.IskiCode, TargetNullValue=''}" TextColor="{StaticResource ColorWarning}" />
                            <Span Text="  " />
                            <Span Text="{Binding PreviewDefect.Type}" TextColor="{StaticResource ColorHighlight}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Label Text="{Binding PreviewDefect.Description}" Style="{StaticResource BodyText}" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,10,0,0">
                    <Button Grid.Column="0" Text="🗑 Sil"
                            Style="{StaticResource DangerButton}"
                            Command="{Binding DeleteDefectCommand}"
                            CommandParameter="{Binding PreviewDefect}" />
                    <Button Grid.Column="1" Text="Kapat"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ClosePreviewCommand}" />
                </Grid>
            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentPage>
