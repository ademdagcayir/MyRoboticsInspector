<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MyRoboticsInspector.ViewModels"
             xmlns:m="clr-namespace:MyRoboticsInspector.Models"
             xmlns:services="clr-namespace:MyRoboticsInspector.Services"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             x:Class="MyRoboticsInspector.MainPage"
             x:DataType="vm:LiveViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource ColorPageBg}">

    <Grid Padding="12" RowDefinitions="*,Auto" ColumnDefinitions="*,300" ColumnSpacing="12">

        <!-- ============== VIDEO + OVERLAY ============== -->
        <Grid Grid.Row="0" Grid.Column="0" x:Name="VideoContainer" RowDefinitions="Auto,*" RowSpacing="10">

            <!-- Büyük alan görünüm seçici: Kamera / MQTT Log / Robot-Pano Konsolu -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,300,*" ColumnSpacing="10" Padding="2,0">
                <Label Grid.Column="0" Text="Görünüm" VerticalOptions="Center"
                       TextColor="{StaticResource ColorTextSecondary}" FontSize="13" FontAttributes="Bold" />
                <Picker Grid.Column="1" ItemsSource="{Binding BigViewOptions}"
                        SelectedItem="{Binding BigViewMode}" />
            </Grid>

            <Border Grid.Row="1" Stroke="{StaticResource ColorBorder}" StrokeThickness="1"
                    Background="{StaticResource GradientVideoVoid}" StrokeShape="RoundRectangle 14">
                <Border.Shadow>
                    <Shadow Brush="#000000" Offset="0,10" Radius="28" Opacity="0.55" />
                </Border.Shadow>
                <Grid>
                  <!-- ===== ÇEVRE BİRİMLERİ (büyük, varsayılan görünüm) ===== -->
                  <ScrollView IsVisible="{Binding IsBigStatus}" Padding="24">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Çevre Birimleri Durumu" TextColor="White"
                               FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" />
                        <Label Text="Kalkış öncesi kontrol — cihazların anlık durumu ve verileri" TextColor="#8A8F9C"
                               FontSize="12" HorizontalOptions="Center" Margin="0,0,0,2" />

                        <!-- ===== SİSTEM HAZIR bandı ===== -->
                        <Border BackgroundColor="#14171F" StrokeThickness="2" StrokeShape="RoundRectangle 12" Padding="16,12"
                                Stroke="#262A35">
                            <Label Text="{Binding SystemReadyText}" HorizontalOptions="Center"
                                   FontSize="16" FontAttributes="Bold"
                                   TextColor="{Binding SystemReady, Converter={StaticResource BoolToConnectionColor}}" />
                        </Border>

                        <!-- İki sütun: SOL = bağlı (zengin), SAĞ = bağlı değil (kompakt) -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                          <!-- ░░░ SOL: BAĞLI ░░░ -->
                          <VerticalStackLayout Grid.Column="0" Spacing="12">
                            <Label Text="✓ BAĞLI" TextColor="#5BCB7A" FontSize="13" FontAttributes="Bold" />

                            <!-- ===== KAMERA ===== -->
                            <Border BackgroundColor="#14171F" StrokeThickness="1" Stroke="#262A35"
                                StrokeShape="RoundRectangle 12" Padding="18,14"
                                IsVisible="{Binding IsCameraOnline}">
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="20,*,Auto" ColumnSpacing="14">
                                    <Border Grid.Column="0" WidthRequest="18" HeightRequest="18" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 9" VerticalOptions="Center"
                                            BackgroundColor="{Binding IsCameraOnline, Converter={StaticResource BoolToConnectionColor}}" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                        <Label Text="Kamera (RTSP)" TextColor="White" FontSize="16" FontAttributes="Bold" />
                                        <Label Text="Canlı görüntü yayını" FontSize="12" TextColor="#8A8F9C" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" VerticalOptions="Center" FontSize="14" FontAttributes="Bold"
                                           Text="{Binding IsCameraOnline, Converter={StaticResource BoolToConnectionText}}"
                                           TextColor="{Binding IsCameraOnline, Converter={StaticResource BoolToConnectionColor}}"
                                           IsVisible="{Binding IsCameraOnline}" />
                                    <Button Grid.Column="2" Text="Bağlan" Style="{StaticResource SecondaryButton}"
                                            FontSize="13" Padding="16,6" Command="{Binding StartStreamCommand}"
                                            IsVisible="{Binding IsCameraOnline, Converter={StaticResource InvertedBool}}" />
                                </Grid>
                                <BoxView HeightRequest="1" Color="#262A35" />
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Label Grid.Column="0" Text="Durum" FontSize="11" TextColor="#8A8F9C" />
                                    <Label Grid.Column="1" FontSize="12" TextColor="White"
                                           Text="{Binding IsStreaming, Converter={StaticResource BoolToConnectionText}}" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                            <!-- ===== BROKER ===== -->
                            <Border BackgroundColor="#14171F" StrokeThickness="1" Stroke="#262A35"
                                StrokeShape="RoundRectangle 12" Padding="18,14"
                                IsVisible="{Binding IsRobotConnected}">
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="20,*,Auto" ColumnSpacing="14">
                                    <Border Grid.Column="0" WidthRequest="18" HeightRequest="18" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 9" VerticalOptions="Center"
                                            BackgroundColor="{Binding IsRobotConnected, Converter={StaticResource BoolToConnectionColor}}" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                        <Label Text="Broker (MQTT)" TextColor="White" FontSize="16" FontAttributes="Bold" />
                                        <Label Text="MQTT bağlantısı" FontSize="12" TextColor="#8A8F9C" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" VerticalOptions="Center" FontSize="14" FontAttributes="Bold"
                                           Text="{Binding IsRobotConnected, Converter={StaticResource BoolToConnectionText}}"
                                           TextColor="{Binding IsRobotConnected, Converter={StaticResource BoolToConnectionColor}}" />
                                </Grid>
                                <BoxView HeightRequest="1" Color="#262A35" />
                                <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="10" RowSpacing="3">
                                    <Label Grid.Column="0" Text="Adres" FontSize="11" TextColor="#8A8F9C" />
                                    <Label Grid.Column="1" Text="{Binding BrokerEndpoint}" FontSize="11" TextColor="White" />
                                    <Label Grid.Column="2" Text="Süreç" FontSize="11" TextColor="#8A8F9C" />
                                    <Label Grid.Column="3" FontSize="11" TextColor="White" Text="Harici (servis)">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsBrokerRunning}" Value="True">
                                                <Setter Property="Text" Value="Uygulama başlattı" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                            <!-- ===== ROBOT ===== -->
                            <Border BackgroundColor="#14171F" StrokeThickness="1" Stroke="#262A35"
                                StrokeShape="RoundRectangle 12" Padding="18,14"
                                IsVisible="{Binding IsRobotOnline}">
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="20,*,Auto" ColumnSpacing="14">
                                    <Border Grid.Column="0" WidthRequest="18" HeightRequest="18" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 9" VerticalOptions="Center"
                                            BackgroundColor="{Binding IsRobotOnline, Converter={StaticResource BoolToConnectionColor}}" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                        <Label Text="Robot" TextColor="White" FontSize="16" FontAttributes="Bold" />
                                        <Label Text="Telemetri akışı" FontSize="12" TextColor="#8A8F9C" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" VerticalOptions="Center" FontSize="14" FontAttributes="Bold"
                                           Text="{Binding IsRobotOnline, Converter={StaticResource BoolToConnectionText}}"
                                           TextColor="{Binding IsRobotOnline, Converter={StaticResource BoolToConnectionColor}}" />
                                </Grid>
                                <BoxView HeightRequest="1" Color="#262A35" />
                                <!-- Telemetri verileri -->
                                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" ColumnSpacing="10" RowSpacing="5"
                                      RowDefinitions="Auto,Auto,Auto">
                                    <Label Grid.Row="0" Grid.Column="0" Text="Mesafe" FontSize="11" TextColor="#8A8F9C" />
                                    <Label Grid.Row="0" Grid.Column="1" FontSize="12" TextColor="White"
                                           Text="{Binding Telemetry.DistanceMeters, StringFormat='{0:0.0} m', TargetNullValue='—'}" />
                                    <Label Grid.Row="0" Grid.Column="2" Text="Hız" FontSize="11" TextColor="#8A8F9C" />
                                    <Label Grid.Row="0" Grid.Column="3" FontSize="12" TextColor="White"
                                           Text="{Binding Telemetry.Speed, StringFormat='{0:0.0}', TargetNullValue='—'}" />
                                    <Label Grid.Row="0" Grid.Column="4" Text="Eğim" FontSize="11" TextColor="#8A8F9C" />
                                    <Label Grid.Row="0" Grid.Column="5" FontSize="12" TextColor="White"
                                           Text="{Binding Telemetry.TiltDegrees, StringFormat='{0:0.0}°', TargetNullValue='—'}" />

                                    <Label Grid.Row="1" Grid.Column="0" Text="Basınç" FontSize="11" TextColor="#8A8F9C" />
                                    <Label Grid.Row="1" Grid.Column="1" FontSize="12" TextColor="White"
                                           Text="{Binding Telemetry.PressurePercent, StringFormat='{0:0}%', TargetNullValue='—'}" />
                                    <Label Grid.Row="1" Grid.Column="2" Text="Sıcaklık" FontSize="11" TextColor="#8A8F9C" />
                                    <Label Grid.Row="1" Grid.Column="3" FontSize="12" TextColor="White"
                                           Text="{Binding Telemetry.TemperatureC, StringFormat='{0:0.0}°C', TargetNullValue='—'}" />
                                    <Label Grid.Row="1" Grid.Column="4" Text="Nem" FontSize="11" TextColor="#8A8F9C" />
                                    <Label Grid.Row="1" Grid.Column="5" FontSize="12" TextColor="White"
                                           Text="{Binding Telemetry.HumidityPercent, StringFormat='{0:0}%', TargetNullValue='—'}" />

                                    <Label Grid.Row="2" Grid.Column="0" Text="Batarya" FontSize="11" TextColor="#8A8F9C" />
                                    <Label Grid.Row="2" Grid.Column="1" FontSize="12" TextColor="White"
                                           Text="{Binding Telemetry.BatteryPercent, StringFormat='{0:0}%', TargetNullValue='—'}" />
                                    <Label Grid.Row="2" Grid.Column="2" Text="Hareket" FontSize="11" TextColor="#8A8F9C" />
                                    <Label Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="3" FontSize="12" TextColor="White"
                                           Text="{Binding Telemetry.ActiveMove, TargetNullValue='—'}" />
                                </Grid>
                                <!-- Alarmlar (yalnızca aktifken görünür) -->
                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="⚠ GAZ ALARMI" FontSize="12" FontAttributes="Bold"
                                           TextColor="{StaticResource ColorDanger}"
                                           IsVisible="{Binding Telemetry.GasAlarm}" />
                                    <Label Text="⚠ SU ALARMI" FontSize="12" FontAttributes="Bold" TextColor="Aqua"
                                           IsVisible="{Binding Telemetry.WaterAlarm}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                            <!-- ===== PANO ===== -->
                            <Border BackgroundColor="#14171F" StrokeThickness="1" Stroke="#262A35"
                                StrokeShape="RoundRectangle 12" Padding="18,14"
                                IsVisible="{Binding IsPanoOnline}">
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="20,*,Auto" ColumnSpacing="14">
                                    <Border Grid.Column="0" WidthRequest="18" HeightRequest="18" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 9" VerticalOptions="Center"
                                            BackgroundColor="{Binding IsPanoOnline, Converter={StaticResource BoolToConnectionColor}}" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                        <Label Text="Pano" TextColor="White" FontSize="16" FontAttributes="Bold" />
                                        <Label Text="pano/log akışı" FontSize="12" TextColor="#8A8F9C" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" VerticalOptions="Center" FontSize="14" FontAttributes="Bold"
                                           Text="{Binding IsPanoOnline, Converter={StaticResource BoolToConnectionText}}"
                                           TextColor="{Binding IsPanoOnline, Converter={StaticResource BoolToConnectionColor}}" />
                                </Grid>
                                <BoxView HeightRequest="1" Color="#262A35" />
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Label Grid.Column="0" Text="Son mesaj" FontSize="11" TextColor="#8A8F9C" VerticalOptions="Start" />
                                    <Label Grid.Column="1" FontSize="12" TextColor="White"
                                           Text="{Binding LastPanoMessage, TargetNullValue='— (henüz mesaj yok)'}" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                            <!-- ===== JOYSTICK ===== -->
                            <Border BackgroundColor="#14171F" StrokeThickness="1" Stroke="#262A35"
                                StrokeShape="RoundRectangle 12" Padding="18,14"
                                IsVisible="{Binding IsGamepadConnected}">
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="20,*,Auto" ColumnSpacing="14">
                                    <Border Grid.Column="0" WidthRequest="18" HeightRequest="18" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 9" VerticalOptions="Center"
                                            BackgroundColor="{Binding IsGamepadConnected, Converter={StaticResource BoolToConnectionColor}}" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                        <Label Text="Joystick" TextColor="White" FontSize="16" FontAttributes="Bold" />
                                        <Label Text="{Binding GamepadStatusText}" FontSize="12" TextColor="#8A8F9C" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" VerticalOptions="Center" FontSize="14" FontAttributes="Bold"
                                           Text="{Binding IsGamepadConnected, Converter={StaticResource BoolToConnectionText}}"
                                           TextColor="{Binding IsGamepadConnected, Converter={StaticResource BoolToConnectionColor}}"
                                           IsVisible="{Binding IsGamepadConnected}" />
                                    <Button Grid.Column="2" Text="Yeniden Bağla" Style="{StaticResource SecondaryButton}"
                                            FontSize="13" Padding="16,6" Command="{Binding ReconnectGamepadCommand}"
                                            IsVisible="{Binding IsGamepadConnected, Converter={StaticResource InvertedBool}}" />
                                </Grid>
                                <BoxView HeightRequest="1" Color="#262A35" />
                                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" ColumnSpacing="10" RowSpacing="5"
                                      RowDefinitions="Auto,Auto,Auto">
                                    <Label Grid.Row="0" Grid.Column="0" Text="Sol X" FontSize="11" TextColor="#8A8F9C" />
                                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding GamepadLX, StringFormat='{0:0.00}'}" FontSize="12" TextColor="White" />
                                    <Label Grid.Row="0" Grid.Column="2" Text="Sol Y" FontSize="11" TextColor="#8A8F9C" />
                                    <Label Grid.Row="0" Grid.Column="3" Text="{Binding GamepadLY, StringFormat='{0:0.00}'}" FontSize="12" TextColor="White" />
                                    <Label Grid.Row="0" Grid.Column="4" Text="LT" FontSize="11" TextColor="#8A8F9C" />
                                    <Label Grid.Row="0" Grid.Column="5" Text="{Binding GamepadLT, StringFormat='{0:0.00}'}" FontSize="12" TextColor="White" />

                                    <Label Grid.Row="1" Grid.Column="0" Text="Sağ X" FontSize="11" TextColor="#8A8F9C" />
                                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding GamepadRX, StringFormat='{0:0.00}'}" FontSize="12" TextColor="White" />
                                    <Label Grid.Row="1" Grid.Column="2" Text="Sağ Y" FontSize="11" TextColor="#8A8F9C" />
                                    <Label Grid.Row="1" Grid.Column="3" Text="{Binding GamepadRY, StringFormat='{0:0.00}'}" FontSize="12" TextColor="White" />
                                    <Label Grid.Row="1" Grid.Column="4" Text="RT" FontSize="11" TextColor="#8A8F9C" />
                                    <Label Grid.Row="1" Grid.Column="5" Text="{Binding GamepadRT, StringFormat='{0:0.00}'}" FontSize="12" TextColor="White" />

                                    <Label Grid.Row="2" Grid.Column="0" Text="Butonlar" FontSize="11" TextColor="#8A8F9C" />
                                    <Label Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="5" Text="{Binding GamepadButtons}" FontSize="12" TextColor="White" />
                                </Grid>
                                <Label Text="{Binding GamepadDiag, StringFormat='XInput: {0}'}" FontSize="10"
                                       TextColor="#6B7280" />
                            </VerticalStackLayout>
                            </Border>
                          </VerticalStackLayout>

                          <!-- ░░░ SAĞ: BAĞLI DEĞİL ░░░ -->
                          <VerticalStackLayout Grid.Column="1" Spacing="12">
                            <Label Text="✕ BAĞLI DEĞİL" TextColor="#FF6B6B" FontSize="13" FontAttributes="Bold" />

                            <!-- Kamera (bağlı değil) -->
                            <Border BackgroundColor="#14171F" StrokeThickness="1" Stroke="#3A2A2A"
                                    StrokeShape="RoundRectangle 12" Padding="16,12"
                                    IsVisible="{Binding IsCameraOnline, Converter={StaticResource InvertedBool}}">
                                <Grid ColumnDefinitions="16,*,Auto" ColumnSpacing="10">
                                    <Border Grid.Column="0" WidthRequest="14" HeightRequest="14" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 7" VerticalOptions="Center"
                                            BackgroundColor="{Binding IsCameraOnline, Converter={StaticResource BoolToConnectionColor}}" />
                                    <Label Grid.Column="1" Text="Kamera (RTSP)" TextColor="White" FontSize="14"
                                           FontAttributes="Bold" VerticalOptions="Center" />
                                    <Button Grid.Column="2" Text="Bağlan" Style="{StaticResource SecondaryButton}"
                                            FontSize="12" Padding="12,4" Command="{Binding StartStreamCommand}" />
                                </Grid>
                            </Border>

                            <!-- Broker (bağlı değil) -->
                            <Border BackgroundColor="#14171F" StrokeThickness="1" Stroke="#3A2A2A"
                                    StrokeShape="RoundRectangle 12" Padding="16,12"
                                    IsVisible="{Binding IsRobotConnected, Converter={StaticResource InvertedBool}}">
                                <Grid ColumnDefinitions="16,*,Auto" ColumnSpacing="10">
                                    <Border Grid.Column="0" WidthRequest="14" HeightRequest="14" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 7" VerticalOptions="Center"
                                            BackgroundColor="{Binding IsRobotConnected, Converter={StaticResource BoolToConnectionColor}}" />
                                    <Label Grid.Column="1" Text="Broker (MQTT)" TextColor="White" FontSize="14"
                                           FontAttributes="Bold" VerticalOptions="Center" />
                                    <Button Grid.Column="2" Text="Bağlan" Style="{StaticResource SecondaryButton}"
                                            FontSize="12" Padding="12,4" Command="{Binding ReconnectBrokerCommand}" />
                                </Grid>
                            </Border>

                            <!-- Robot (bağlı değil) -->
                            <Border BackgroundColor="#14171F" StrokeThickness="1" Stroke="#3A2A2A"
                                    StrokeShape="RoundRectangle 12" Padding="16,12"
                                    IsVisible="{Binding IsRobotOnline, Converter={StaticResource InvertedBool}}">
                                <Grid ColumnDefinitions="16,*,Auto" ColumnSpacing="10">
                                    <Border Grid.Column="0" WidthRequest="14" HeightRequest="14" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 7" VerticalOptions="Center"
                                            BackgroundColor="{Binding IsRobotOnline, Converter={StaticResource BoolToConnectionColor}}" />
                                    <Label Grid.Column="1" Text="Robot" TextColor="White" FontSize="14"
                                           FontAttributes="Bold" VerticalOptions="Center" />
                                    <Label Grid.Column="2" Text="Telemetri bekleniyor" FontSize="11" TextColor="#8A8F9C"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Border>

                            <!-- Pano (bağlı değil) -->
                            <Border BackgroundColor="#14171F" StrokeThickness="1" Stroke="#3A2A2A"
                                    StrokeShape="RoundRectangle 12" Padding="16,12"
                                    IsVisible="{Binding IsPanoOnline, Converter={StaticResource InvertedBool}}">
                                <Grid ColumnDefinitions="16,*,Auto" ColumnSpacing="10">
                                    <Border Grid.Column="0" WidthRequest="14" HeightRequest="14" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 7" VerticalOptions="Center"
                                            BackgroundColor="{Binding IsPanoOnline, Converter={StaticResource BoolToConnectionColor}}" />
                                    <Label Grid.Column="1" Text="Pano" TextColor="White" FontSize="14"
                                           FontAttributes="Bold" VerticalOptions="Center" />
                                    <Label Grid.Column="2" Text="Log bekleniyor" FontSize="11" TextColor="#8A8F9C"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Border>

                            <!-- Joystick (bağlı değil) -->
                            <Border BackgroundColor="#14171F" StrokeThickness="1" Stroke="#3A2A2A"
                                    StrokeShape="RoundRectangle 12" Padding="16,12"
                                    IsVisible="{Binding IsGamepadConnected, Converter={StaticResource InvertedBool}}">
                                <Grid ColumnDefinitions="16,*,Auto" ColumnSpacing="10">
                                    <Border Grid.Column="0" WidthRequest="14" HeightRequest="14" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 7" VerticalOptions="Center"
                                            BackgroundColor="{Binding IsGamepadConnected, Converter={StaticResource BoolToConnectionColor}}" />
                                    <Label Grid.Column="1" Text="Joystick" TextColor="White" FontSize="14"
                                           FontAttributes="Bold" VerticalOptions="Center" />
                                    <Button Grid.Column="2" Text="Yeniden Bağla" Style="{StaticResource SecondaryButton}"
                                            FontSize="12" Padding="12,4" Command="{Binding ReconnectGamepadCommand}" />
                                </Grid>
                            </Border>
                          </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                  </ScrollView>

                  <!-- ===== KAMERA ===== -->
                  <Grid IsVisible="{Binding IsBigCamera}">
                    <!-- Canlı kamera: SkiaSharp composite kare.
                         Proje/adres/baca/metre overlay'i kareye SENKRON gömülü (canlı=kayıt). -->
                    <skia:SKCanvasView x:Name="VideoCanvas"
                                       IsVisible="{Binding HasLiveFrame}" />

                    <!-- Yayın yokken placeholder -->
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="14"
                                         IsVisible="{Binding HasLiveFrame, Converter={StaticResource InvertedBool}}">
                        <Border WidthRequest="92" HeightRequest="92" HorizontalOptions="Center"
                                StrokeThickness="1" Stroke="#2A2C36"
                                StrokeShape="RoundRectangle 46" Background="#12141B">
                            <Label Text="&#xE714;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="40" TextColor="{StaticResource ColorAccentSoft}"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="Kamera görüntüsü bekleniyor"
                               TextColor="White" FontSize="18" FontAttributes="Bold"
                               HorizontalOptions="Center" />
                        <Label Text="Sağ panelden “Yeniden Bağlan” düğmesine dokunun"
                               TextColor="#8A8F9C" FontSize="13"
                               HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                        <Label Text="{Binding StatusMessage}"
                               TextColor="{StaticResource ColorWarning}" FontSize="12"
                               HorizontalOptions="Center" HorizontalTextAlignment="Center"
                               IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmpty}}" />
                    </VerticalStackLayout>

                    <!-- BASINÇ BARI — stream'in altında, pil tarzı renkli dolum (60+ yeşil / 40-60 turuncu / <40 kırmızı) -->
                    <Border VerticalOptions="End" Margin="16" Padding="14,9" InputTransparent="True"
                            BackgroundColor="#B0000000" StrokeThickness="0" StrokeShape="RoundRectangle 10"
                            IsVisible="{Binding HasLiveFrame}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                            <Label Grid.Column="0" Text="Basınç" TextColor="#D6D9E0" FontSize="13"
                                   VerticalOptions="Center" />
                            <Border Grid.Column="1" VerticalOptions="Center" HeightRequest="18"
                                    BackgroundColor="#33FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 9">
                                <ProgressBar Progress="{Binding Telemetry.PressureFill}"
                                             ProgressColor="{Binding Telemetry.PressureBarColor}"
                                             HeightRequest="18" VerticalOptions="Center" BackgroundColor="Transparent" />
                            </Border>
                            <Label Grid.Column="2" FontAttributes="Bold" FontSize="15" VerticalOptions="Center"
                                   TextColor="{Binding Telemetry.PressureBarColor}"
                                   Text="{Binding Telemetry.PressurePercent, StringFormat='{0:0}%', TargetNullValue='—'}" />
                        </Grid>
                    </Border>
                  </Grid>
                  <!-- /KAMERA -->

                  <!-- ===== MQTT LOG (büyük görünüm) ===== -->
                  <Grid IsVisible="{Binding IsBigMqtt}" RowDefinitions="Auto,Auto,*" Padding="14" RowSpacing="8">
                      <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                          <Label Grid.Column="0" Text="MQTT TRAFİK" TextColor="White"
                                 FontAttributes="Bold" FontSize="15" VerticalOptions="Center" />
                          <Button Grid.Column="1" Text="🗑 Temizle" Style="{StaticResource QuietButton}"
                                  Padding="10,4" Command="{Binding ClearMqttLogCommand}" />
                          <Button Grid.Column="2" Style="{StaticResource QuietButton}" Padding="10,4"
                                  Command="{Binding ToggleBrokerCommand}">
                              <Button.Triggers>
                                  <DataTrigger TargetType="Button" Binding="{Binding IsBrokerRunning}" Value="True">
                                      <Setter Property="Text" Value="■ Broker Durdur" />
                                  </DataTrigger>
                                  <DataTrigger TargetType="Button" Binding="{Binding IsBrokerRunning}" Value="False">
                                      <Setter Property="Text" Value="▶ Broker Başlat" />
                                  </DataTrigger>
                              </Button.Triggers>
                          </Button>
                      </Grid>

                      <!-- Elle yayın tezgahı (bring-up): joystick olmadan bilinen komut gönder -->
                      <Border Grid.Row="1" BackgroundColor="#11161F" StrokeThickness="0"
                              StrokeShape="RoundRectangle 8" Padding="10">
                          <VerticalStackLayout Spacing="8">
                              <Label Text="ELLE YAYIN — joystick olmadan robotu test et" FontSize="11"
                                     FontAttributes="Bold" TextColor="{StaticResource ColorCyan}" />
                              <Label Text="Test sürüşü DUR'a basana kadar süreklidir (firmware: ileri=-100, geri=+100, sağ=lr-100, sol=lr+100)."
                                     FontSize="9" TextColor="#8A8F9C" />
                              <!-- Sürüş testi (streamer üzerinden sürekli — watchdog beslenir) -->
                              <FlexLayout Wrap="Wrap" JustifyContent="Start">
                                  <Button Text="▲ İleri" Style="{StaticResource QuietButton}" FontSize="11" Margin="0,0,6,6"
                                          Command="{Binding TestDriveCommand}" CommandParameter="fwd" />
                                  <Button Text="▼ Geri" Style="{StaticResource QuietButton}" FontSize="11" Margin="0,0,6,6"
                                          Command="{Binding TestDriveCommand}" CommandParameter="back" />
                                  <Button Text="◀ Sol" Style="{StaticResource QuietButton}" FontSize="11" Margin="0,0,6,6"
                                          Command="{Binding TestDriveCommand}" CommandParameter="left" />
                                  <Button Text="▶ Sağ" Style="{StaticResource QuietButton}" FontSize="11" Margin="0,0,6,6"
                                          Command="{Binding TestDriveCommand}" CommandParameter="right" />
                                  <Button Text="■ DUR" Style="{StaticResource DangerButton}" FontSize="11" Margin="0,0,6,6"
                                          Command="{Binding TestDriveCommand}" CommandParameter="stop" />
                              </FlexLayout>
                              <!-- Ham protokol tek-atış (kafa/fren/diag vb. için) -->
                              <Grid ColumnDefinitions="*,90,Auto" ColumnSpacing="6">
                                  <Picker Grid.Column="0" Title="topic" ItemsSource="{Binding ManualTopicOptions}"
                                          SelectedItem="{Binding ManualTopic}" FontSize="11" TextColor="White" />
                                  <Entry Grid.Column="1" Text="{Binding ManualPayload}" Placeholder="değer"
                                         Keyboard="Numeric" FontSize="12" TextColor="White" />
                                  <Button Grid.Column="2" Text="Gönder" Style="{StaticResource SecondaryButton}"
                                          FontSize="12" Padding="14,4" Command="{Binding ManualPublishCustomCommand}" />
                              </Grid>
                          </VerticalStackLayout>
                      </Border>

                      <!-- TEK-METİN terminal (en yeni üstte) — titremez -->
                      <ScrollView Grid.Row="2" VerticalScrollBarVisibility="Always">
                          <Label Text="{Binding MqttConsoleText}" FontSize="11" TextColor="#D6FFE6"
                                 FontFamily="OpenSansRegular" LineBreakMode="NoWrap" />
                      </ScrollView>
                  </Grid>

                  <!-- ===== ROBOT / PANO KONSOLU (büyük görünüm) ===== -->
                  <Grid IsVisible="{Binding IsBigConsole}" RowDefinitions="Auto,Auto,*" Padding="14" RowSpacing="8">
                      <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                          <Label Grid.Column="0" Text="CİHAZ KONSOLU" TextColor="White"
                                 FontAttributes="Bold" FontSize="15" VerticalOptions="Center" />
                          <Button Grid.Column="1" Text="{Binding RobotDiagButtonText}" Style="{StaticResource SecondaryButton}"
                                  FontSize="12" Padding="10,4" Command="{Binding RunRobotDiagnosticsCommand}" />
                          <Button Grid.Column="2" Text="{Binding PanoDiagButtonText}" Style="{StaticResource SecondaryButton}"
                                  FontSize="12" Padding="10,4" Command="{Binding RunPanoDiagnosticsCommand}" />
                          <Button Grid.Column="3" Text="🗑" Style="{StaticResource QuietButton}"
                                  Padding="10,4" Command="{Binding ClearDeviceLogCommand}" />
                      </Grid>

                      <!-- CİHAZ DURUMU — teşhisten gelen değerler YERİNDE güncellenir (kaymaz/titremez) -->
                      <Border Grid.Row="1" BackgroundColor="#11161F" StrokeThickness="0"
                              StrokeShape="RoundRectangle 8" Padding="12,10">
                          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="3">
                              <Label Grid.Row="0" Grid.Column="0" Text="Sürüş" FontSize="11" TextColor="#8A8F9C" />
                              <Label Grid.Row="0" Grid.Column="1" Text="{Binding RobotDriveStatus}" FontSize="13" FontAttributes="Bold"
                                     TextColor="{StaticResource ColorCyan}" FontFamily="OpenSansRegular" />
                              <Label Grid.Row="1" Grid.Column="0" Text="Kafa" FontSize="11" TextColor="#8A8F9C" />
                              <Label Grid.Row="1" Grid.Column="1" Text="{Binding RobotHeadStatus}" FontSize="13" TextColor="White"
                                     FontFamily="OpenSansRegular" />
                              <Label Grid.Row="2" Grid.Column="0" Text="Son komut" FontSize="11" TextColor="#8A8F9C" />
                              <Label Grid.Row="2" Grid.Column="1" Text="{Binding RobotSinceStatus}" FontSize="12" TextColor="#B8BDC9"
                                     FontFamily="OpenSansRegular" />
                              <Label Grid.Row="3" Grid.Column="0" Text="Uptime" FontSize="11" TextColor="#8A8F9C" />
                              <Label Grid.Row="3" Grid.Column="1" Text="{Binding RobotUptimeStatus}" FontSize="12" TextColor="#B8BDC9"
                                     FontFamily="OpenSansRegular" />
                          </Grid>
                      </Border>

                      <!-- TEK-METİN terminal (en yeni üstte) — titremez -->
                      <ScrollView Grid.Row="2" VerticalScrollBarVisibility="Always">
                          <Label Text="{Binding DeviceConsoleText}" FontSize="11" TextColor="#D6E4FF"
                                 FontFamily="OpenSansRegular" LineBreakMode="NoWrap" />
                      </ScrollView>
                  </Grid>
                </Grid>
            </Border>

            <!-- CANLI SENSÖR ŞERİDİ — operatör farkındalığı (kayda GÖMÜLMEZ).
                 Proje/adres/baca/metre/saat/REC artık composite kareye SENKRON gömülü. -->
            <VerticalStackLayout Grid.Row="1" Padding="18" Spacing="2" InputTransparent="True"
                                 HorizontalOptions="End" VerticalOptions="End"
                                 IsVisible="{Binding IsBigCamera}">
                <Label Text="{Binding Telemetry.TiltDegrees, StringFormat='Eğim: {0:0.0}°', TargetNullValue=''}"
                       TextColor="White" FontSize="12" HorizontalOptions="End" />
                <Label Text="{Binding Telemetry.PressurePercent, StringFormat='Basınç: {0:0}%', TargetNullValue=''}"
                       TextColor="White" FontSize="12" HorizontalOptions="End" />
                <Label Text="{Binding Telemetry.TemperatureC, StringFormat='Sıcaklık: {0:0.0}°C', TargetNullValue=''}"
                       TextColor="White" FontSize="12" HorizontalOptions="End" />
                <Label Text="{Binding Telemetry.BatteryPercent, StringFormat='Batarya: {0:0}%', TargetNullValue=''}"
                       TextColor="White" FontSize="12" HorizontalOptions="End" />
                <Label Text="⚠ GAZ" TextColor="{StaticResource ColorDanger}" FontSize="14" FontAttributes="Bold" HorizontalOptions="End"
                       IsVisible="{Binding Telemetry.GasAlarm}" />
                <Label Text="⚠ SU" TextColor="Aqua" FontSize="14" FontAttributes="Bold" HorizontalOptions="End"
                       IsVisible="{Binding Telemetry.WaterAlarm}" />
            </VerticalStackLayout>
        </Grid>

        <!-- ============== RIGHT PANEL ============== -->
        <ScrollView Grid.Row="0" Grid.Column="1">
            <VerticalStackLayout Spacing="10">

                    <!-- ============== MARKA / LOGO ============== -->
                    <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" Margin="0,2,0,2">
                        <Border BackgroundColor="#FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 22"
                                HeightRequest="44" WidthRequest="44" VerticalOptions="Center">
                            <Image Source="logo.png" HeightRequest="34" WidthRequest="34" Aspect="AspectFit"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="My Robotics" FontSize="19" FontAttributes="Bold"
                               TextColor="{StaticResource ColorTextPrimary}" VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <!-- ============== ÇEVRE BİRİMLERİ (online/offline) ============== -->
                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="ÇEVRE BİRİMLERİ" Style="{StaticResource SectionTitle}" />

                            <!-- Kamera -->
                            <Grid ColumnDefinitions="14,*,Auto" ColumnSpacing="8">
                                <Border Grid.Column="0" WidthRequest="11" HeightRequest="11" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 6" VerticalOptions="Center"
                                        BackgroundColor="{Binding IsCameraOnline, Converter={StaticResource BoolToConnectionColor}}" />
                                <Label Grid.Column="1" Text="Kamera (RTSP)" VerticalOptions="Center"
                                       FontSize="13" TextColor="{StaticResource ColorTextPrimary}" />
                                <Label Grid.Column="2" VerticalOptions="Center" FontSize="11"
                                       Text="{Binding IsCameraOnline, Converter={StaticResource BoolToConnectionText}}"
                                       TextColor="{Binding IsCameraOnline, Converter={StaticResource BoolToConnectionColor}}"
                                       IsVisible="{Binding IsCameraOnline}" />
                                <Button Grid.Column="2" Text="Bağlan" Style="{StaticResource QuietButton}"
                                        FontSize="11" Padding="10,2" Command="{Binding StartStreamCommand}"
                                        IsVisible="{Binding IsCameraOnline, Converter={StaticResource InvertedBool}}" />
                            </Grid>

                            <!-- Broker -->
                            <Grid ColumnDefinitions="14,*,Auto" ColumnSpacing="8">
                                <Border Grid.Column="0" WidthRequest="11" HeightRequest="11" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 6" VerticalOptions="Center"
                                        BackgroundColor="{Binding IsRobotConnected, Converter={StaticResource BoolToConnectionColor}}" />
                                <Label Grid.Column="1" Text="Broker (MQTT)" VerticalOptions="Center"
                                       FontSize="13" TextColor="{StaticResource ColorTextPrimary}" />
                                <Label Grid.Column="2" VerticalOptions="Center" FontSize="11"
                                       Text="{Binding IsRobotConnected, Converter={StaticResource BoolToConnectionText}}"
                                       TextColor="{Binding IsRobotConnected, Converter={StaticResource BoolToConnectionColor}}"
                                       IsVisible="{Binding IsRobotConnected}" />
                                <Button Grid.Column="2" Text="Bağlan" Style="{StaticResource QuietButton}"
                                        FontSize="11" Padding="10,2" Command="{Binding ReconnectBrokerCommand}"
                                        IsVisible="{Binding IsRobotConnected, Converter={StaticResource InvertedBool}}" />
                            </Grid>

                            <!-- Robot -->
                            <Grid ColumnDefinitions="14,*,Auto" ColumnSpacing="8">
                                <Border Grid.Column="0" WidthRequest="11" HeightRequest="11" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 6" VerticalOptions="Center"
                                        BackgroundColor="{Binding IsRobotOnline, Converter={StaticResource BoolToConnectionColor}}" />
                                <Label Grid.Column="1" Text="Robot" VerticalOptions="Center"
                                       FontSize="13" TextColor="{StaticResource ColorTextPrimary}" />
                                <Label Grid.Column="2" VerticalOptions="Center" FontSize="11"
                                       Text="{Binding IsRobotOnline, Converter={StaticResource BoolToConnectionText}}"
                                       TextColor="{Binding IsRobotOnline, Converter={StaticResource BoolToConnectionColor}}" />
                            </Grid>

                            <!-- Pano -->
                            <Grid ColumnDefinitions="14,*,Auto" ColumnSpacing="8">
                                <Border Grid.Column="0" WidthRequest="11" HeightRequest="11" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 6" VerticalOptions="Center"
                                        BackgroundColor="{Binding IsPanoOnline, Converter={StaticResource BoolToConnectionColor}}" />
                                <Label Grid.Column="1" Text="Pano" VerticalOptions="Center"
                                       FontSize="13" TextColor="{StaticResource ColorTextPrimary}" />
                                <Label Grid.Column="2" VerticalOptions="Center" FontSize="11"
                                       Text="{Binding IsPanoOnline, Converter={StaticResource BoolToConnectionText}}"
                                       TextColor="{Binding IsPanoOnline, Converter={StaticResource BoolToConnectionColor}}" />
                            </Grid>

                            <!-- Joystick -->
                            <Grid ColumnDefinitions="14,*,Auto" ColumnSpacing="8">
                                <Border Grid.Column="0" WidthRequest="11" HeightRequest="11" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 6" VerticalOptions="Center"
                                        BackgroundColor="{Binding IsGamepadConnected, Converter={StaticResource BoolToConnectionColor}}" />
                                <Label Grid.Column="1" Text="Joystick" VerticalOptions="Center"
                                       FontSize="13" TextColor="{StaticResource ColorTextPrimary}" />
                                <Label Grid.Column="2" VerticalOptions="Center" FontSize="11"
                                       Text="{Binding IsGamepadConnected, Converter={StaticResource BoolToConnectionText}}"
                                       TextColor="{Binding IsGamepadConnected, Converter={StaticResource BoolToConnectionColor}}"
                                       IsVisible="{Binding IsGamepadConnected}" />
                                <Button Grid.Column="2" Text="Yeniden Bağla" Style="{StaticResource QuietButton}"
                                        FontSize="11" Padding="10,2" Command="{Binding ReconnectGamepadCommand}"
                                        IsVisible="{Binding IsGamepadConnected, Converter={StaticResource InvertedBool}}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- ============== DEFECT MINI-LIST ============== -->
                    <Border Style="{StaticResource CardBorder}"
                            IsVisible="{Binding IsInspecting}">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="EKLENEN KUSURLAR" Style="{StaticResource SectionTitle}" />
                            <CollectionView ItemsSource="{Binding ActiveDefects}"
                                            MaximumHeightRequest="220"
                                            SelectionMode="None">
                                <CollectionView.EmptyView>
                                    <Label Text="Henüz kusur yok"
                                           Style="{StaticResource Caption}" HorizontalOptions="Center" />
                                </CollectionView.EmptyView>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="m:Defect">
                                        <Border Padding="6" Margin="0,0,0,4"
                                                Stroke="{StaticResource ColorBorder}" StrokeThickness="1"
                                                StrokeShape="RoundRectangle 6"
                                                Background="{StaticResource ColorSurfaceHigh}">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LiveViewModel}}, Path=PreviewDefectAtCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Grid ColumnDefinitions="50,*,Auto" ColumnSpacing="6">
                                                <Image Grid.Column="0" Source="{Binding PhotoPath}"
                                                       HeightRequest="36" WidthRequest="50"
                                                       Aspect="AspectFill" BackgroundColor="{StaticResource ColorSurfaceSubtle}" />
                                                <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                                    <Label TextColor="{StaticResource ColorTextPrimary}" FontSize="12" FontAttributes="Bold">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Text="{Binding IskiCode, TargetNullValue=''}" TextColor="{StaticResource ColorWarning}" />
                                                                <Span Text="  " />
                                                                <Span Text="{Binding Type}" />
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                    <Label Style="{StaticResource Caption}" FontSize="10">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Text="{Binding DistanceMeters, StringFormat='{0:0.0} m', TargetNullValue='— m'}" />
                                                                <Span Text="  •  " TextColor="{StaticResource ColorTextTertiary}" />
                                                                <Span Text="{Binding VideoTimestampMs, Converter={StaticResource MsToTimestamp}}" />
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                </VerticalStackLayout>
                                                <Button Grid.Column="2" Text="🗑"
                                                        Style="{StaticResource QuietButton}"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LiveViewModel}}, Path=DeleteDefectCommand}"
                                                        CommandParameter="{Binding .}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                    <!-- ============== KAMERA + KAYIT ============== -->
                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="KAMERA" Style="{StaticResource SectionTitle}" />
                            <!-- Yayın aktifken: sadece durdur butonu; kopunca: yeniden bağlan -->
                            <Button Text="⏹ Yayını Durdur"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding StopStreamCommand}"
                                    IsVisible="{Binding IsStreaming}" />
                            <Button Text="🔄 Yeniden Bağlan"
                                    Style="{StaticResource WarningButton}"
                                    Command="{Binding StartStreamCommand}"
                                    IsVisible="{Binding IsStreaming, Converter={StaticResource InvertedBool}}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <Button Grid.Column="0"
                                        Text="{Binding IsRecording, Converter={StaticResource BoolToRecordText}}"
                                        Style="{StaticResource DangerButton}"
                                        BackgroundColor="{Binding IsRecording, Converter={StaticResource BoolToRecordColor}}"
                                        Command="{Binding ToggleRecordingCommand}" />
                                <Button Grid.Column="1" Text="📷"
                                        Style="{StaticResource SecondaryButton}"
                                        WidthRequest="48" Padding="0"
                                        Command="{Binding SnapshotCommand}" />
                            </Grid>
                            <!-- Son kayıt izle / klasör aç -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6"
                                  IsVisible="{Binding HasLastRecording}">
                                <Button Grid.Column="0" Text="▶ Son Kaydı İzle"
                                        Style="{StaticResource PrimaryButton}"
                                        Command="{Binding OpenLastRecordingCommand}" />
                                <Button Grid.Column="1" Text="📁"
                                        Style="{StaticResource SecondaryButton}"
                                        WidthRequest="48" Padding="0"
                                        ToolTipProperties.Text="Kayıt klasörünü aç"
                                        Command="{Binding OpenRecordingsFolderCommand}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- ============== CİHAZ KONSOLU (robot/log + pano/log) ============== -->
                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <Label Grid.Column="0" Text="CİHAZ KONSOLU" Style="{StaticResource SectionTitle}"
                                       VerticalOptions="Center" />
                                <Button Grid.Column="1" Text="🗑"
                                        Style="{StaticResource QuietButton}" Padding="8,4"
                                        Command="{Binding ClearDeviceLogCommand}"
                                        IsVisible="{Binding ShowDeviceConsole}"
                                        ToolTipProperties.Text="Konsolu temizle" />
                                <Button Grid.Column="2"
                                        Text="{Binding ShowDeviceConsole, Converter={StaticResource BoolToGamepadButtonText}}"
                                        Style="{StaticResource QuietButton}" Padding="8,4"
                                        Command="{Binding ToggleDeviceConsoleCommand}" />
                            </Grid>

                            <!-- Teşhis tetikleme butonları -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                <Button Grid.Column="0" Text="{Binding RobotDiagButtonText}"
                                        Style="{StaticResource SecondaryButton}" FontSize="12" Padding="0,6"
                                        Command="{Binding RunRobotDiagnosticsCommand}" />
                                <Button Grid.Column="1" Text="{Binding PanoDiagButtonText}"
                                        Style="{StaticResource SecondaryButton}" FontSize="12" Padding="0,6"
                                        Command="{Binding RunPanoDiagnosticsCommand}" />
                            </Grid>

                            <!-- Konsol (tek-metin terminal, en yeni üstte → titremez) -->
                            <Border Background="{StaticResource ColorSurfaceSubtle}" StrokeThickness="0" StrokeShape="RoundRectangle 6"
                                    Padding="8,6" IsVisible="{Binding ShowDeviceConsole}">
                                <ScrollView HeightRequest="240" VerticalScrollBarVisibility="Always">
                                    <Label Text="{Binding DeviceConsoleText}" FontSize="10" TextColor="{StaticResource ColorTextPrimary}"
                                           FontFamily="OpenSansRegular" LineBreakMode="NoWrap" />
                                </ScrollView>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <!-- ============== MQTT TRAFFIC LOG ============== -->
                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <Label Grid.Column="0" Text="MQTT LOG" Style="{StaticResource SectionTitle}"
                                       VerticalOptions="Center" />
                                <Button Grid.Column="1" Text="🗑"
                                        Style="{StaticResource QuietButton}" Padding="8,4"
                                        Command="{Binding ClearMqttLogCommand}"
                                        IsVisible="{Binding ShowMqttLog}"
                                        ToolTipProperties.Text="Temizle" />
                                <Button Grid.Column="2"
                                        Text="{Binding ShowMqttLog, Converter={StaticResource BoolToGamepadButtonText}}"
                                        Style="{StaticResource QuietButton}" Padding="8,4"
                                        Command="{Binding ToggleMqttLogCommand}" />
                            </Grid>

                            <!-- Yerel broker yönetimi + bağlantı durumu -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="0,0,0,2">
                                <Label Grid.Column="0" FontSize="11" VerticalOptions="Center">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="Broker  " TextColor="{StaticResource ColorTextTertiary}" />
                                            <Span Text="{Binding IsRobotConnected, Converter={StaticResource BoolToConnectionText}}"
                                                  TextColor="{Binding IsRobotConnected, Converter={StaticResource BoolToConnectionColor}}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Button Grid.Column="1" Style="{StaticResource QuietButton}" Padding="10,4" FontSize="12"
                                        Command="{Binding ToggleBrokerCommand}">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding IsBrokerRunning}" Value="True">
                                            <Setter Property="Text" Value="■ Broker'ı Durdur" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Button" Binding="{Binding IsBrokerRunning}" Value="False">
                                            <Setter Property="Text" Value="▶ Broker'ı Başlat" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                            </Grid>

                            <!-- Log (tek-metin terminal, en yeni üstte → titremez) -->
                            <Border Background="{StaticResource ColorSurfaceSubtle}" StrokeThickness="0" StrokeShape="RoundRectangle 6"
                                    Padding="8,6" IsVisible="{Binding ShowMqttLog}">
                                <ScrollView HeightRequest="260" VerticalScrollBarVisibility="Always">
                                    <Label Text="{Binding MqttConsoleText}" FontSize="10" TextColor="{StaticResource ColorTextPrimary}"
                                           FontFamily="OpenSansRegular" LineBreakMode="NoWrap" />
                                </ScrollView>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <!-- ============== JOYSTICK + MANUEL ============== -->
                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="GİRDİ" Style="{StaticResource SectionTitle}"
                                       VerticalOptions="Center" />
                                <Button Grid.Column="1"
                                        Text="{Binding IsGamepadActive, Converter={StaticResource BoolToGamepadButtonText}}"
                                        Style="{StaticResource QuietButton}"
                                        Command="{Binding ToggleGamepadCommand}" />
                            </Grid>
                            <Label Text="{Binding GamepadStatusText}" Style="{StaticResource Caption}" />

                            <!-- Joystick anlık girdi göstergesi -->
                            <Border Background="{StaticResource ColorSurfaceSubtle}" StrokeThickness="0" StrokeShape="RoundRectangle 6"
                                    Padding="10,8"
                                    IsVisible="{Binding IsGamepadConnected}">
                                <VerticalStackLayout Spacing="4">
                                    <!-- Butonlar -->
                                    <Label Text="BUTONLAR" Style="{StaticResource SectionTitle}" FontSize="9" />
                                    <Label Text="{Binding GamepadButtons}"
                                           TextColor="{StaticResource ColorWarning}" FontSize="13" FontAttributes="Bold"
                                           FontFamily="OpenSansRegular" />

                                    <!-- Sol stick -->
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,4,0,0">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="SOL STICK" Style="{StaticResource SectionTitle}" FontSize="9" />
                                            <Label FontSize="11" TextColor="{StaticResource ColorTextPrimary}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="X " TextColor="{StaticResource ColorTextSecondary}" />
                                                        <Span Text="{Binding GamepadLX, StringFormat='{0:+0.00;-0.00; 0.00}'}"
                                                              TextColor="{StaticResource ColorHighlight}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <Label FontSize="11" TextColor="{StaticResource ColorTextPrimary}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="Y " TextColor="{StaticResource ColorTextSecondary}" />
                                                        <Span Text="{Binding GamepadLY, StringFormat='{0:+0.00;-0.00; 0.00}'}"
                                                              TextColor="{StaticResource ColorHighlight}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </VerticalStackLayout>

                                        <!-- Sağ stick -->
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="SAĞ STICK" Style="{StaticResource SectionTitle}" FontSize="9" />
                                            <Label FontSize="11" TextColor="{StaticResource ColorTextPrimary}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="X " TextColor="{StaticResource ColorTextSecondary}" />
                                                        <Span Text="{Binding GamepadRX, StringFormat='{0:+0.00;-0.00; 0.00}'}"
                                                              TextColor="{StaticResource ColorHighlight}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <Label FontSize="11" TextColor="{StaticResource ColorTextPrimary}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="Y " TextColor="{StaticResource ColorTextSecondary}" />
                                                        <Span Text="{Binding GamepadRY, StringFormat='{0:+0.00;-0.00; 0.00}'}"
                                                              TextColor="{StaticResource ColorHighlight}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </VerticalStackLayout>
                                    </Grid>

                                    <!-- Tetikleyiciler -->
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,4,0,0">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="LT" Style="{StaticResource SectionTitle}" FontSize="9" />
                                            <ProgressBar Progress="{Binding GamepadLT}"
                                                         ProgressColor="{StaticResource ColorWarning}"
                                                         HeightRequest="6" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="RT" Style="{StaticResource SectionTitle}" FontSize="9" />
                                            <ProgressBar Progress="{Binding GamepadRT}"
                                                         ProgressColor="{StaticResource ColorWarning}"
                                                         HeightRequest="6" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Manuel sürüş: klavye (W/A/S/D veya ok tuşları) + dpad (basılı tut) -->
                            <Label Style="{StaticResource Caption}" Margin="0,4,0,0">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Manuel sürüş — " />
                                        <Span Text="W A S D" TextColor="{StaticResource ColorAccentSoft}" FontAttributes="Bold" />
                                        <Span Text=" / ok tuşları" />
                                        <Span Text="  •  görüntüye tıkla, sonra tuşlarla sür" TextColor="{StaticResource ColorTextTertiary}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Grid ColumnDefinitions="*,*,*" RowDefinitions="44,44,44"
                                  ColumnSpacing="4" RowSpacing="4">
                                <Button Grid.Row="0" Grid.Column="1" Text="▲" FontSize="18"
                                        Style="{StaticResource SecondaryButton}">
                                    <Button.GestureRecognizers>
                                        <PointerGestureRecognizer
                                            PointerPressedCommand="{Binding PressForwardCommand}"
                                            PointerReleasedCommand="{Binding ReleaseDpadCommand}"
                                            PointerExitedCommand="{Binding ReleaseDpadCommand}" />
                                    </Button.GestureRecognizers>
                                </Button>
                                <Button Grid.Row="1" Grid.Column="0" Text="◀" FontSize="18"
                                        Style="{StaticResource SecondaryButton}">
                                    <Button.GestureRecognizers>
                                        <PointerGestureRecognizer
                                            PointerPressedCommand="{Binding PressLeftCommand}"
                                            PointerReleasedCommand="{Binding ReleaseDpadCommand}"
                                            PointerExitedCommand="{Binding ReleaseDpadCommand}" />
                                    </Button.GestureRecognizers>
                                </Button>
                                <Button Grid.Row="1" Grid.Column="1" Text="■" FontSize="18"
                                        BackgroundColor="{StaticResource ColorDanger}" TextColor="White"
                                        CornerRadius="8"
                                        Command="{Binding ReleaseDpadCommand}" />
                                <Button Grid.Row="1" Grid.Column="2" Text="▶" FontSize="18"
                                        Style="{StaticResource SecondaryButton}">
                                    <Button.GestureRecognizers>
                                        <PointerGestureRecognizer
                                            PointerPressedCommand="{Binding PressRightCommand}"
                                            PointerReleasedCommand="{Binding ReleaseDpadCommand}"
                                            PointerExitedCommand="{Binding ReleaseDpadCommand}" />
                                    </Button.GestureRecognizers>
                                </Button>
                                <Button Grid.Row="2" Grid.Column="1" Text="▼" FontSize="18"
                                        Style="{StaticResource SecondaryButton}">
                                    <Button.GestureRecognizers>
                                        <PointerGestureRecognizer
                                            PointerPressedCommand="{Binding PressBackwardCommand}"
                                            PointerReleasedCommand="{Binding ReleaseDpadCommand}"
                                            PointerExitedCommand="{Binding ReleaseDpadCommand}" />
                                    </Button.GestureRecognizers>
                                </Button>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>

        <!-- ============== STATUS BAR (full width) ============== -->
        <Border Grid.Row="1" Grid.ColumnSpan="2"
                Background="{StaticResource ColorSurface}"
                Stroke="{StaticResource ColorBorder}" StrokeThickness="1"
                StrokeShape="RoundRectangle 6"
                Padding="12,6" Margin="0,10,0,0">
            <Label Text="{Binding StatusMessage}" Style="{StaticResource BodyText}" FontSize="12" />
        </Border>

        <!-- ============== DEFECT ADD MODAL ============== -->
        <Border Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="2"
                IsVisible="{Binding IsMarkingDefect}"
                Background="#dd000000" Padding="24">
            <ScrollView>
                <VerticalStackLayout Spacing="12" MaximumWidthRequest="720" HorizontalOptions="Center">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Kusur Ekle" FontSize="22" FontAttributes="Bold" TextColor="White" />
                        <Button Grid.Column="1" Text="✕" Padding="14,6"
                                Style="{StaticResource QuietButton}"
                                Command="{Binding CancelDefectCommand}" />
                    </Grid>

                    <Image Source="{Binding EditingDefectSnapshotPath}"
                           HeightRequest="220" Aspect="AspectFit" BackgroundColor="#222" />

                    <!-- İSKİ quick-pick chips -->
                    <Label Text="İSKİ HIZLI KOD" Style="{StaticResource SectionTitle}" />
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding IskiCodes}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="m:IskiDefectCode">
                                    <Border Stroke="{StaticResource ColorBorderStrong}" StrokeThickness="1"
                                            StrokeShape="RoundRectangle 14"
                                            Background="{StaticResource ColorSurfaceHigh}"
                                            Padding="10,5">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LiveViewModel}}, Path=ApplyIskiCodeCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Label FontSize="12" TextColor="{StaticResource ColorTextPrimary}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Code}" TextColor="{StaticResource ColorWarning}" FontAttributes="Bold" />
                                                    <Span Text="  " />
                                                    <Span Text="{Binding Title}" TextColor="{StaticResource ColorTextSecondary}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Mesafe (m)" Style="{StaticResource Caption}" />
                            <Entry Text="{Binding EditingDefect.DistanceMeters}" Keyboard="Numeric" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Video Zamanı (ms)" Style="{StaticResource Caption}" />
                            <Entry Text="{Binding EditingDefect.VideoTimestampMs}" Keyboard="Numeric" IsReadOnly="True" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Şiddet" Style="{StaticResource Caption}" />
                            <Picker ItemsSource="{Binding SeverityOptions}"
                                    SelectedItem="{Binding EditingDefect.Severity}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Tür" Style="{StaticResource Caption}" />
                            <Picker ItemsSource="{Binding DefectTypes}"
                                    SelectedItem="{Binding EditingDefect.Type}" />
                        </VerticalStackLayout>
                    </Grid>

                    <VerticalStackLayout>
                        <Label Text="Açıklama" Style="{StaticResource Caption}" />
                        <Editor Text="{Binding EditingDefect.Description}" HeightRequest="100"
                                Placeholder="Detay, konum, gözlem..." />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,10,0,0">
                        <Button Grid.Column="0" Text="İptal"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding CancelDefectCommand}" />
                        <Button Grid.Column="1" Text="Kaydet"
                                Style="{StaticResource SuccessButton}"
                                Command="{Binding SaveDefectCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </ScrollView>
        </Border>

        <!-- ============== DEFECT PREVIEW OVERLAY ============== -->
        <Border Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="2"
                IsVisible="{Binding IsPreviewingDefect}"
                Background="#dd000000" Padding="24">
            <VerticalStackLayout Spacing="12" MaximumWidthRequest="720" HorizontalOptions="Center">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="Kusur Önizleme" FontSize="22" FontAttributes="Bold" TextColor="White" />
                    <Button Grid.Column="1" Text="✕" Padding="14,6"
                            Style="{StaticResource QuietButton}"
                            Command="{Binding ClosePreviewCommand}" />
                </Grid>
                <Image Source="{Binding PreviewDefect.PhotoPath}"
                       HeightRequest="380" Aspect="AspectFit" BackgroundColor="#222" />
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="Şiddet" Style="{StaticResource Caption}" />
                        <Label Text="{Binding PreviewDefect.Severity}" Style="{StaticResource CardTitle}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1">
                        <Label Text="Mesafe" Style="{StaticResource Caption}" />
                        <Label Text="{Binding PreviewDefect.DistanceMeters, StringFormat='{0:0.0} m', TargetNullValue='—'}"
                               Style="{StaticResource CardTitle}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2">
                        <Label Text="Video Zamanı" Style="{StaticResource Caption}" />
                        <Label Text="{Binding PreviewDefect.VideoTimestampMs, Converter={StaticResource MsToTimestamp}}"
                               Style="{StaticResource CardTitle}" />
                    </VerticalStackLayout>
                </Grid>
                <Label FontSize="15" FontAttributes="Bold">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding PreviewDefect.IskiCode, TargetNullValue=''}" TextColor="{StaticResource ColorWarning}" />
                            <Span Text="  " />
                            <Span Text="{Binding PreviewDefect.Type}" TextColor="{StaticResource ColorHighlight}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Label Text="{Binding PreviewDefect.Description}" Style="{StaticResource BodyText}" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,10,0,0">
                    <Button Grid.Column="0" Text="🗑 Sil"
                            Style="{StaticResource DangerButton}"
                            Command="{Binding DeleteDefectCommand}"
                            CommandParameter="{Binding PreviewDefect}" />
                    <Button Grid.Column="1" Text="Kapat"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ClosePreviewCommand}" />
                </Grid>
            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentPage>
