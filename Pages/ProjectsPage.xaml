<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MyRoboticsInspector.ViewModels"
             x:Class="MyRoboticsInspector.Pages.ProjectsPage"
             x:DataType="vm:ProjectsViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource ColorPageBg}">

    <Grid RowDefinitions="Auto,*" RowSpacing="0">

        <!-- ── HEADER ── -->
        <Grid Grid.Row="0" Padding="28,24,28,16" ColumnDefinitions="*,Auto">
            <VerticalStackLayout Grid.Column="0" Spacing="2">
                <Label Text="Projeler" FontSize="26" FontAttributes="Bold"
                       TextColor="{StaticResource ColorTextPrimary}" />
                <HorizontalStackLayout Spacing="4">
                    <Label Text="{Binding Projects.Count}" FontSize="13" FontAttributes="Bold"
                           TextColor="{StaticResource ColorHighlight}" />
                    <Label Text="proje" FontSize="13"
                           TextColor="{StaticResource ColorTextTertiary}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <Button Grid.Column="1" Text="+ Yeni Proje"
                    Style="{StaticResource PrimaryButton}"
                    Padding="18,10" VerticalOptions="Center"
                    FontSize="13" Command="{Binding NewProjectCommand}" />
        </Grid>

        <!-- ── LİSTE ── -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding Projects}"
                        SelectionMode="None" Margin="0">

            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center"
                                     Spacing="12" Padding="40">
                    <Label Text="📁" FontSize="44" HorizontalOptions="Center" Opacity="0.4" />
                    <Label Text="Henüz proje yok" FontSize="16" FontAttributes="Bold"
                           TextColor="{StaticResource ColorTextPrimary}" HorizontalOptions="Center" />
                    <Label Text="Başlamak için ilk projenizi oluşturun."
                           FontSize="13" TextColor="{StaticResource ColorTextTertiary}"
                           HorizontalOptions="Center" />
                    <Button Text="+ Yeni Proje Oluştur" Style="{StaticResource PrimaryButton}"
                            Padding="20,10" HorizontalOptions="Center" FontSize="13"
                            Command="{Binding NewProjectCommand}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="0" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ProjectListItem">

                    <!-- Kart: tıkla → kanallar -->
                    <Grid Padding="20,6,20,6">
                        <Border Background="{StaticResource ColorSurface}"
                                Stroke="{StaticResource ColorBorder}" StrokeThickness="1"
                                StrokeShape="RoundRectangle 10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProjectsViewModel}}, Path=OpenChannelsCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="0" Padding="18,14,12,14">

                                <!-- ── SATIR 1: Başlık + aksiyon butonları ── -->
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="{Binding Project.Title}"
                                               FontSize="15" FontAttributes="Bold"
                                               TextColor="{StaticResource ColorTextPrimary}"
                                               LineBreakMode="TailTruncation" MaxLines="1" />
                                        <Label Text="{Binding CustomerName}"
                                               FontSize="12"
                                               TextColor="{StaticResource ColorTextTertiary}"
                                               IsVisible="{Binding CustomerName, Converter={StaticResource StringNotEmpty}}" />
                                    </VerticalStackLayout>

                                    <!-- Aksiyon butonları — sağ üst -->
                                    <HorizontalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Start">
                                        <Button Text="+ Kanal"
                                                FontSize="12" FontAttributes="Bold"
                                                BackgroundColor="#1a3d2b"
                                                TextColor="#5ccf8a"
                                                CornerRadius="5"
                                                HeightRequest="28" Padding="10,0"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProjectsViewModel}}, Path=AddChannelCommand}"
                                                CommandParameter="{Binding .}" />
                                        <Button Text="✎"
                                                FontSize="13" Background="Transparent"
                                                TextColor="{StaticResource ColorTextSecondary}"
                                                HeightRequest="28" WidthRequest="32" Padding="0"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProjectsViewModel}}, Path=EditCommand}"
                                                CommandParameter="{Binding .}" />
                                        <Button Text="✕"
                                                FontSize="12" Background="Transparent"
                                                TextColor="#555"
                                                HeightRequest="28" WidthRequest="32" Padding="0"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProjectsViewModel}}, Path=DeleteCommand}"
                                                CommandParameter="{Binding .}" />
                                    </HorizontalStackLayout>
                                </Grid>

                                <!-- ── SATIR 2: Konum + tarih bilgisi ── -->
                                <HorizontalStackLayout Grid.Row="1" Spacing="12" Margin="0,8,0,0">
                                    <!-- Tarih -->
                                    <Label FontSize="11" TextColor="{StaticResource ColorTextTertiary}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Project.ProjectDate, StringFormat='{0:dd.MM.yyyy}'}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <!-- Konum -->
                                    <Label Text="{Binding LocationLabel}"
                                           FontSize="11" TextColor="{StaticResource ColorTextTertiary}"
                                           IsVisible="{Binding LocationLabel, Converter={StaticResource StringNotEmpty}}" />
                                    <!-- Hakediş -->
                                    <Label Text="{Binding Project.HakedisNo, StringFormat='HK: {0}'}"
                                           FontSize="11" TextColor="{StaticResource ColorTextTertiary}"
                                           IsVisible="{Binding Project.HakedisNo, Converter={StaticResource StringNotEmpty}}" />
                                </HorizontalStackLayout>

                                <!-- ── SATIR 3: Badge'ler + kanal sayısı ── -->
                                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                                    <HorizontalStackLayout Grid.Column="0" Spacing="6">
                                        <!-- Aşama badge -->
                                        <Border Padding="8,3"
                                                Background="#0d2b1a"
                                                StrokeShape="RoundRectangle 4"
                                                StrokeThickness="0">
                                            <Label Text="{Binding StageLabel}" FontSize="11"
                                                   TextColor="#5ccf8a" />
                                        </Border>
                                        <!-- Amaç badge -->
                                        <Border Padding="8,3"
                                                Background="#1a1a2e"
                                                StrokeShape="RoundRectangle 4"
                                                StrokeThickness="0">
                                            <Label Text="{Binding PurposeLabel}" FontSize="11"
                                                   TextColor="{StaticResource ColorAccent}" />
                                        </Border>
                                    </HorizontalStackLayout>

                                    <!-- Kanal sayısı -->
                                    <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                        <Label Text="{Binding ChannelCount}" FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource ColorHighlight}" />
                                        <Label Text="kanal" FontSize="12"
                                               TextColor="{StaticResource ColorTextTertiary}" />
                                    </HorizontalStackLayout>
                                </Grid>

                            </Grid>
                        </Border>
                    </Grid>

                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
