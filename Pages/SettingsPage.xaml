<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MyRoboticsInspector.ViewModels"
             x:Class="MyRoboticsInspector.Pages.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource ColorPageBg}">

    <Grid RowDefinitions="Auto,*">

        <!-- Sticky header -->
        <Border Grid.Row="0" Background="{StaticResource ColorSurface}"
                Stroke="{StaticResource ColorBorder}" StrokeThickness="0,0,0,1"
                Padding="16,12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="AYARLAR" Style="{StaticResource SectionTitle}" />
                    <Label Text="Sistem Ayarları" FontSize="20" FontAttributes="Bold"
                           TextColor="{StaticResource ColorTextPrimary}" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="✓  Kaydet"
                        Style="{StaticResource SuccessButton}"
                        Padding="20,0" Command="{Binding SaveCommand}" />
            </Grid>
        </Border>

        <ScrollView Grid.Row="1" Padding="16">
            <VerticalStackLayout Spacing="12" MaximumWidthRequest="720" HorizontalOptions="Start">

                <!-- ============== GÖRÜNÜM / TEMA ============== -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="GÖRÜNÜM" Style="{StaticResource SectionTitle}" />
                        <Grid ColumnDefinitions="*,200" ColumnSpacing="10" VerticalOptions="Center">
                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                <Label Text="Tema" Style="{StaticResource Caption}" />
                                <Label Text="Koyu / Açık / Sistem — anında uygulanır"
                                       FontSize="10" TextColor="{StaticResource ColorTextTertiary}" />
                            </VerticalStackLayout>
                            <Picker Grid.Column="1"
                                    ItemsSource="{Binding ThemeOptions}"
                                    SelectedItem="{Binding SelectedTheme}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- ============== PROJE / KONUM ============== -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="PROJE / KONUM (overlay'de görünür)" Style="{StaticResource SectionTitle}" />
                        <VerticalStackLayout>
                            <Label Text="Proje Adı" Style="{StaticResource Caption}" />
                            <Entry Text="{Binding Settings.ProjectName}" Placeholder="örn. Atakent Yağmursuyu" />
                        </VerticalStackLayout>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="Mahalle" Style="{StaticResource Caption}" />
                                <Entry Text="{Binding Settings.Neighborhood}" Placeholder="örn. Atakent" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="Sokak" Style="{StaticResource Caption}" />
                                <Entry Text="{Binding Settings.Street}" Placeholder="örn. 234. Sokak" />
                            </VerticalStackLayout>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="Operatör Adı" Style="{StaticResource Caption}" />
                                <Entry Text="{Binding Settings.OperatorName}" Placeholder="örn. Adem Dağcayır" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="Cihaz Adı (bulut)" Style="{StaticResource Caption}" />
                                <Entry Text="{Binding Settings.DeviceLabel}" Placeholder="örn. Saha Tableti 1" />
                            </VerticalStackLayout>
                        </Grid>
                        <Label Text="Operatör + cihaz + robot bilgisi her kanal kaydına işlenir; bulutta firma hesabı içinde bunlara göre ayrışır."
                               FontSize="10" TextColor="{StaticResource ColorTextTertiary}" />
                    </VerticalStackLayout>
                </Border>

                <!-- ============== KAMERA (RTSP) ============== -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="KAMERA (RTSP)" Style="{StaticResource SectionTitle}" />
                        <VerticalStackLayout>
                            <Label Text="Canlı Önizleme URL (sub-stream /102)" Style="{StaticResource Caption}" />
                            <Entry Text="{Binding Settings.RtspUrl}"
                                   Placeholder="rtsp://admin:sifre@192.168.1.64:554/Streaming/Channels/102" />
                            <Label Text="Düşük bant — canlı ekranda gösterilir"
                                   FontSize="10" TextColor="{StaticResource ColorTextTertiary}" Margin="0,2,0,0" />
                        </VerticalStackLayout>
                        <VerticalStackLayout>
                            <Label Text="Kayıt URL (ana stream /101)" Style="{StaticResource Caption}" />
                            <Entry Text="{Binding Settings.RecordingRtspUrl}"
                                   Placeholder="rtsp://admin:sifre@192.168.1.64:554/Streaming/Channels/101" />
                            <Label Text="Yüksek kalite — MP4 kaydına yazılır"
                                   FontSize="10" TextColor="{StaticResource ColorTextTertiary}" Margin="0,2,0,0" />
                        </VerticalStackLayout>
                        <VerticalStackLayout>
                            <Label Text="Ağ Önbellek (ms)" Style="{StaticResource Caption}" />
                            <Entry Text="{Binding Settings.NetworkCachingMs}" Keyboard="Numeric" />
                            <Label Text="Düşük = az gecikme, çok = daha az takılma"
                                   FontSize="10" TextColor="{StaticResource ColorTextTertiary}" Margin="0,4,0,0" />
                        </VerticalStackLayout>

                        <!-- Önizleme (/102) metre↔kare senkron gecikme telafisi -->
                        <VerticalStackLayout>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Önizleme Senkron Gecikmesi (/102)" Style="{StaticResource Caption}" />
                                <Label Grid.Column="1"
                                       Text="{Binding Settings.MeterSyncOffsetMs, StringFormat='{0} ms'}"
                                       Style="{StaticResource Caption}"
                                       TextColor="{StaticResource ColorAccentSoft}" FontAttributes="Bold" />
                            </Grid>
                            <Slider Minimum="0" Maximum="1000"
                                    Value="{Binding Settings.MeterSyncOffsetMs}"
                                    MinimumTrackColor="{StaticResource ColorAccent}"
                                    ThumbColor="{StaticResource ColorAccentSoft}" />
                            <Label Text="Canlı önizlemedeki metre yazısının kareyle hizası (tipik 150–400 ms)."
                                   FontSize="10" TextColor="{StaticResource ColorTextTertiary}" Margin="0,2,0,0" />
                        </VerticalStackLayout>

                        <!-- KAYIT (/101 4K) metre↔kare senkron gecikme telafisi -->
                        <VerticalStackLayout>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Kayıt Senkron Gecikmesi (/101)" Style="{StaticResource Caption}" />
                                <Label Grid.Column="1"
                                       Text="{Binding Settings.RecordingMeterSyncOffsetMs, StringFormat='{0} ms'}"
                                       Style="{StaticResource Caption}"
                                       TextColor="{StaticResource ColorAccentSoft}" FontAttributes="Bold" />
                            </Grid>
                            <Slider Minimum="0" Maximum="2000"
                                    Value="{Binding Settings.RecordingMeterSyncOffsetMs}"
                                    MinimumTrackColor="{StaticResource ColorAccent}"
                                    ThumbColor="{StaticResource ColorAccentSoft}" />
                            <Label Text="KAYDEDİLEN videoda metre↔kare hizası. Teslim edilen video /101 olduğu için asıl kalibrasyon budur: robotu bilinen bir işaretten geçirip kayıttaki metre o kareye düşene dek ayarlayın."
                                   FontSize="10" TextColor="{StaticResource ColorTextTertiary}" Margin="0,2,0,0" />
                        </VerticalStackLayout>

                        <!-- Kayıt encoder -->
                        <VerticalStackLayout>
                            <Label Text="Kayıt Encoder" Style="{StaticResource Caption}" />
                            <Picker ItemsSource="{Binding RecordingEncoders}"
                                    SelectedItem="{Binding Settings.RecordingEncoder}" />
                            <Label Text="auto: nvenc→qsv→libx264 otomatik seçer. Donma/atlama olursa libx264 (CPU) en güvenli."
                                   FontSize="10" TextColor="{StaticResource ColorTextTertiary}" Margin="0,2,0,0" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- ============== MQTT BROKER ============== -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="MQTT BROKER" Style="{StaticResource SectionTitle}" />
                        <Grid ColumnDefinitions="*,120" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="Broker Host" Style="{StaticResource Caption}" />
                                <Entry Text="{Binding Settings.BrokerHost}" Placeholder="IP veya host" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="Port" Style="{StaticResource Caption}" />
                                <Entry Text="{Binding Settings.BrokerPort}" Keyboard="Numeric" />
                            </VerticalStackLayout>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="Kullanıcı (opsiyonel)" Style="{StaticResource Caption}" />
                                <Entry Text="{Binding Settings.BrokerUsername}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="Şifre" Style="{StaticResource Caption}" />
                                <Entry Text="{Binding Settings.BrokerPassword}" IsPassword="True" />
                            </VerticalStackLayout>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="Topic Prefix" Style="{StaticResource Caption}" />
                                <Entry Text="{Binding Settings.TopicPrefix}" Placeholder="myrobotics" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="Robot ID" Style="{StaticResource Caption}" />
                                <Entry Text="{Binding Settings.RobotId}" Placeholder="robot1" />
                            </VerticalStackLayout>
                        </Grid>
                        <Label Text="Komutlar → {prefix}/{robotId}/cmd  •  Telemetri ← {prefix}/{robotId}/telemetry"
                               FontSize="10" TextColor="{StaticResource ColorTextTertiary}" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,4,0,0">
                            <Button Grid.Column="0" Text="Bağlantıyı Test Et (2 sn)"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding TestConnectionCommand}"
                                    IsEnabled="{Binding IsTesting, Converter={StaticResource InvertedBool}}" />
                            <ActivityIndicator Grid.Column="1"
                                               IsRunning="{Binding IsTesting}" IsVisible="{Binding IsTesting}"
                                               Color="{StaticResource ColorAccent}" VerticalOptions="Center" />
                        </Grid>
                        <Label Text="{Binding TestResult}" Style="{StaticResource Caption}"
                               IsVisible="{Binding TestResult, Converter={StaticResource StringNotEmpty}}" />
                    </VerticalStackLayout>
                </Border>

                <!-- ============== YEDEKLEME ============== -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="YEDEKLEME (OneDrive)" Style="{StaticResource SectionTitle}" />
                        <Border Background="{StaticResource ColorSurfaceHigh}"
                                StrokeShape="RoundRectangle 6" StrokeThickness="0"
                                Padding="10">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{Binding BackupStatusText}"
                                       TextColor="{Binding BackupStatusColor}" FontAttributes="Bold" />
                                <Label Text="{Binding BackupRecommendedFolder, StringFormat='Önerilen klasör: {0}'}"
                                       FontSize="11" TextColor="{StaticResource ColorTextTertiary}"
                                       IsVisible="{Binding OneDriveAvailable}" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="{Binding OneDriveAvailable}">
                                    <Button Grid.Column="0" Text="📁 OneDrive'a yönlendir"
                                            Style="{StaticResource PrimaryButton}"
                                            Command="{Binding UseOneDriveCommand}" />
                                    <Button Grid.Column="1" Text="📦 Eski verileri taşı"
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{Binding MigrateExistingDataCommand}"
                                            IsEnabled="{Binding IsMigrating, Converter={StaticResource InvertedBool}}" />
                                </Grid>
                                <Label Text="{Binding MigrationLog}" Style="{StaticResource Caption}"
                                       IsVisible="{Binding MigrationLog, Converter={StaticResource StringNotEmpty}}" />
                                <ActivityIndicator IsRunning="{Binding IsMigrating}" IsVisible="{Binding IsMigrating}"
                                                   Color="{StaticResource ColorAccent}" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- ============== BULUT YEDEK (Supabase) ============== -->
                <Border Style="{StaticResource CardBorder}" Stroke="#59C6A15B" StrokeThickness="1.4">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="☁️ BULUT YEDEK" Style="{StaticResource SectionTitle}"
                                   TextColor="#C6A15B" />
                            <Label Grid.Column="1" Text="{Binding CloudStatusText}"
                                   TextColor="{Binding CloudStatusColor}" FontSize="12"
                                   FontAttributes="Bold" VerticalOptions="Center" />
                        </Grid>

                        <!-- Hesap yokken: giriş / kayıt -->
                        <VerticalStackLayout Spacing="8"
                                             IsVisible="{Binding IsCloudSignedIn, Converter={StaticResource InvertedBool}}">
                            <Label Text="Videolar, resimler, raporlar ve tüm veriler hesabınıza şifreli olarak yedeklenir. Her operatör/firma kendi hesabıyla çalışır — veriler birbirinden tamamen izoledir."
                                   FontSize="11" TextColor="{StaticResource ColorTextTertiary}" />
                            <Entry Text="{Binding CloudEmailInput}" Placeholder="E-posta" Keyboard="Email" />
                            <Entry Text="{Binding CloudPasswordInput}" Placeholder="Parola" IsPassword="True" />
                            <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="10">
                                <Button Grid.Column="0" Text="🔑 Giriş Yap"
                                        Style="{StaticResource PrimaryButton}"
                                        Command="{Binding CloudSignInCommand}"
                                        IsEnabled="{Binding IsCloudBusy, Converter={StaticResource InvertedBool}}" />
                                <Button Grid.Column="1" Text="✨ Hesap Oluştur"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding CloudSignUpCommand}"
                                        IsEnabled="{Binding IsCloudBusy, Converter={StaticResource InvertedBool}}" />
                                <ActivityIndicator Grid.Column="2" IsRunning="{Binding IsCloudBusy}"
                                                   IsVisible="{Binding IsCloudBusy}"
                                                   Color="#C6A15B" VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Hesap varken: durum + kuyruk + dosyalar + korumalı silme -->
                        <VerticalStackLayout Spacing="10" IsVisible="{Binding IsCloudSignedIn}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <Label Grid.Column="0" Text="{Binding CloudSignedInEmail, StringFormat='👤 {0}'}"
                                       Style="{StaticResource BodyText}" VerticalOptions="Center" />
                                <Button Grid.Column="1" Text="Çıkış" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding CloudSignOutCommand}" />
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Switch Grid.Column="0" IsToggled="{Binding Settings.CloudBackupEnabled}" />
                                <Label Grid.Column="1" Text="Otomatik bulut yedekleme"
                                       Style="{StaticResource BodyText}" VerticalOptions="Center" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Switch Grid.Column="0" IsToggled="{Binding Settings.CloudIncludeVideos}" />
                                <Label Grid.Column="1" Text="Videolar da yedeklensin (büyük dosyalar)"
                                       Style="{StaticResource BodyText}" VerticalOptions="Center" />
                            </Grid>

                            <Label Text="{Binding CloudCurrentItem}" FontSize="11"
                                   TextColor="{StaticResource ColorTextTertiary}"
                                   IsVisible="{Binding CloudCurrentItem, Converter={StaticResource StringNotEmpty}}" />
                            <Label Text="{Binding CloudQueueText}" FontSize="12"
                                   TextColor="{StaticResource ColorTextSecondary}"
                                   IsVisible="{Binding CloudQueueText, Converter={StaticResource StringNotEmpty}}" />

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <Button Grid.Column="0" Text="⬆ Şimdi Yedekle"
                                        Style="{StaticResource PrimaryButton}"
                                        Command="{Binding CloudSyncNowCommand}" />
                                <Button Grid.Column="1" Text="🔄 Bulut Listesini Yenile"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding LoadCloudFilesCommand}"
                                        IsEnabled="{Binding IsCloudFilesLoading, Converter={StaticResource InvertedBool}}" />
                            </Grid>

                            <Label Text="{Binding CloudTotalsText}" FontSize="12" FontAttributes="Bold"
                                   TextColor="#C6A15B"
                                   IsVisible="{Binding CloudTotalsText, Converter={StaticResource StringNotEmpty}}" />

                            <!-- Son yüklenen dosyalar + PIN korumalı silme -->
                            <VerticalStackLayout Spacing="4"
                                                 BindableLayout.ItemsSource="{Binding CloudFiles}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CloudFileDisplay">
                                        <Border Background="{StaticResource ColorSurfaceHigh}"
                                                StrokeShape="RoundRectangle 6" StrokeThickness="0" Padding="8,6">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <VerticalStackLayout Grid.Column="0" Spacing="1">
                                                    <Label Text="{Binding FileName}" FontSize="12"
                                                           LineBreakMode="MiddleTruncation" />
                                                    <Label Text="{Binding Detail}" FontSize="10"
                                                           TextColor="{StaticResource ColorTextTertiary}" />
                                                </VerticalStackLayout>
                                                <Button Grid.Column="1" Text="🔒🗑" FontSize="12"
                                                        Padding="8,4" BackgroundColor="Transparent"
                                                        TextColor="#e66"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SettingsViewModel}}, Path=DeleteCloudFileCommand}"
                                                        CommandParameter="{Binding .}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <Button Grid.Column="0" Text="🔐 Silme PIN'i Belirle / Değiştir"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding SetCloudDeletePinCommand}" />
                                <Button Grid.Column="1" Text="Kilidi Kapat"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding LockCloudDeleteCommand}"
                                        IsVisible="{Binding IsCloudDeleteUnlocked}" />
                            </Grid>
                            <Label Text="Buluta her şey otomatik EKLENİR; buluttan silme yalnız sunucu doğrulamalı PIN ile açılan 5 dakikalık pencerede mümkündür. PIN sunucuda bcrypt ile saklanır — uygulamada veya cihazda tutulmaz."
                                   FontSize="10" TextColor="{StaticResource ColorTextTertiary}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- ============== DEPOLAMA ============== -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="DEPOLAMA" Style="{StaticResource SectionTitle}" />
                        <VerticalStackLayout>
                            <Label Text="Video / Snapshot / Rapor Klasörü" Style="{StaticResource Caption}" />
                            <Entry Text="{Binding Settings.StoragePath}" Placeholder="boş = varsayılan" />
                            <Label Text="Bu yolu OneDrive klasörüne ayarlarsan tüm kayıtlar otomatik yedeklenir."
                                   FontSize="10" TextColor="{StaticResource ColorTextTertiary}" Margin="0,4,0,0" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- ============== JOYSTICK ============== -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="JOYSTICK (Logitech F710 / XInput)" Style="{StaticResource SectionTitle}" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Switch Grid.Column="0" IsToggled="{Binding Settings.GamepadAutoStart}" />
                            <Label Grid.Column="1"
                                   Text="Uygulama açılınca joystick'i otomatik başlat"
                                   Style="{StaticResource BodyText}" VerticalOptions="Center" />
                        </Grid>
                        <Label Text="F710'u 'X' (XInput) moduna al. Sol stick = sürüş • RT = tam hız, LT = yavaş • A = snapshot, B = ACİL DUR, X = ışık, Y = kusur, Start = kayıt, Back = inceleme başlat/bitir."
                               FontSize="10" TextColor="{StaticResource ColorTextTertiary}" />
                    </VerticalStackLayout>
                </Border>

                <!-- ============== FFMPEG ============== -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="FFMPEG (kayda overlay göm)" Style="{StaticResource SectionTitle}" />
                        <VerticalStackLayout>
                            <Label Text="FFmpeg Yolu" Style="{StaticResource Caption}" />
                            <Entry Text="{Binding Settings.FfmpegPath}" Placeholder="ffmpeg.exe" />
                            <Label Text="FFmpeg yoksa kayıt LibVLC ile overlay'siz devam eder."
                                   FontSize="10" TextColor="{StaticResource ColorTextTertiary}" Margin="0,4,0,0" />
                        </VerticalStackLayout>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Switch Grid.Column="0" IsToggled="{Binding Settings.BurnOverlayInRecording}" />
                            <Label Grid.Column="1"
                                   Text="Kayıtta overlay'ı göm (proje, mesafe, sensörler)"
                                   Style="{StaticResource BodyText}" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- ============== OVERLAY YAZISI (font + boyut) ============== -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="GÖRÜNTÜ OVERLAY YAZISI" Style="{StaticResource SectionTitle}" />
                        <VerticalStackLayout>
                            <Label Text="Font" Style="{StaticResource Caption}" />
                            <Picker ItemsSource="{Binding OverlayFonts}"
                                    SelectedItem="{Binding Settings.OverlayFontFamily}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Yazı Boyutu" Style="{StaticResource Caption}" />
                                <Label Grid.Column="1"
                                       Text="{Binding Settings.OverlayFontScale, StringFormat='{0:0.00}×'}"
                                       Style="{StaticResource Caption}"
                                       TextColor="{StaticResource ColorAccentSoft}" FontAttributes="Bold" />
                            </Grid>
                            <Slider Minimum="0.5" Maximum="2.5"
                                    Value="{Binding Settings.OverlayFontScale}"
                                    MinimumTrackColor="{StaticResource ColorAccent}"
                                    ThumbColor="{StaticResource ColorAccentSoft}" />
                            <Label Text="Görüntüye gömülen proje/baca/metre yazılarının fontu ve boyutu. Kaydet'e basınca canlı görüntü ve kayda anında uygulanır."
                                   FontSize="10" TextColor="{StaticResource ColorTextTertiary}" Margin="0,2,0,0" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- ============== KALİBRASYON (Eğim + Basınç) ============== -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="SENSÖR KALİBRASYONU" Style="{StaticResource SectionTitle}" />

                        <!-- Anlık ham okumalar (yakalama referansı) -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Label Grid.Column="0" FontSize="11" TextColor="{StaticResource ColorTextSecondary}"
                                   Text="{Binding Telemetry.TiltRaw, StringFormat='Anlık eğim ham: {0}', TargetNullValue='Anlık eğim ham: —'}" />
                            <Label Grid.Column="1" FontSize="11" TextColor="{StaticResource ColorTextSecondary}"
                                   Text="{Binding Telemetry.PressureRaw, StringFormat='Anlık basınç ham: {0}', TargetNullValue='Anlık basınç ham: —'}" />
                        </Grid>

                        <!-- EĞİM 3-nokta -->
                        <Label Text="Eğim (°) — 3 referans" FontAttributes="Bold" FontSize="12" />
                        <Grid ColumnDefinitions="80,*,Auto" ColumnSpacing="8" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                            <Label Grid.Row="0" Grid.Column="0" Text="0° (yatay)" FontSize="11" VerticalOptions="Center" />
                            <Entry Grid.Row="0" Grid.Column="1" Text="{Binding Settings.TiltRaw0Deg}" Keyboard="Numeric" Placeholder="ham ADC" />
                            <Button Grid.Row="0" Grid.Column="2" Text="📍 Yakala" Style="{StaticResource SecondaryButton}" FontSize="11" Padding="10,4" Command="{Binding CaptureTilt0Command}" />

                            <Label Grid.Row="1" Grid.Column="0" Text="-45°" FontSize="11" VerticalOptions="Center" />
                            <Entry Grid.Row="1" Grid.Column="1" Text="{Binding Settings.TiltRawMinus45}" Keyboard="Numeric" Placeholder="ham ADC" />
                            <Button Grid.Row="1" Grid.Column="2" Text="📍 Yakala" Style="{StaticResource SecondaryButton}" FontSize="11" Padding="10,4" Command="{Binding CaptureTiltMinus45Command}" />

                            <Label Grid.Row="2" Grid.Column="0" Text="+45°" FontSize="11" VerticalOptions="Center" />
                            <Entry Grid.Row="2" Grid.Column="1" Text="{Binding Settings.TiltRawPlus45}" Keyboard="Numeric" Placeholder="ham ADC" />
                            <Button Grid.Row="2" Grid.Column="2" Text="📍 Yakala" Style="{StaticResource SecondaryButton}" FontSize="11" Padding="10,4" Command="{Binding CaptureTiltPlus45Command}" />
                        </Grid>
                        <Label Text="Robotu ilgili açıya getirip 'Yakala'ya basın (ya da değeri elle girin). Gelen ham ADC bu referanslara göre ±dereceye çevrilir."
                               FontSize="10" TextColor="{StaticResource ColorTextTertiary}" />

                        <!-- BASINÇ min/max -->
                        <Label Text="Basınç (%) — min/max aralık" FontAttributes="Bold" FontSize="12" Margin="0,6,0,0" />
                        <Grid ColumnDefinitions="80,*,Auto" ColumnSpacing="8" RowDefinitions="Auto,Auto" RowSpacing="6">
                            <Label Grid.Row="0" Grid.Column="0" Text="Min (%0)" FontSize="11" VerticalOptions="Center" />
                            <Entry Grid.Row="0" Grid.Column="1" Text="{Binding Settings.PressureRawMin}" Keyboard="Numeric" Placeholder="alt sınır ham ADC" />
                            <Button Grid.Row="0" Grid.Column="2" Text="📍 Yakala" Style="{StaticResource SecondaryButton}" FontSize="11" Padding="10,4" Command="{Binding CapturePressureMinCommand}" />

                            <Label Grid.Row="1" Grid.Column="0" Text="Max (%100)" FontSize="11" VerticalOptions="Center" />
                            <Entry Grid.Row="1" Grid.Column="1" Text="{Binding Settings.PressureRawMax}" Keyboard="Numeric" Placeholder="üst sınır ham ADC" />
                            <Button Grid.Row="1" Grid.Column="2" Text="📍 Yakala" Style="{StaticResource SecondaryButton}" FontSize="11" Padding="10,4" Command="{Binding CapturePressureMaxCommand}" />
                        </Grid>
                        <Label Text="Basınç bu aralıkta %0–100'e ölçeklenir; stream altında pil-tarzı barda gösterilir (≥%60 yeşil, %40–60 turuncu, &lt;%40 kırmızı)."
                               FontSize="10" TextColor="{StaticResource ColorTextTertiary}" />
                    </VerticalStackLayout>
                </Border>

                <!-- ============== ŞİRKET ============== -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="ŞİRKET" Style="{StaticResource SectionTitle}" />
                        <VerticalStackLayout>
                            <Label Text="Şirket Adı (raporlarda görünür)" Style="{StaticResource Caption}" />
                            <Entry Text="{Binding Settings.CompanyName}" Placeholder="My Robotics" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- ============== GÜNCELLEME (Velopack) ============== -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="OTOMATİK GÜNCELLEME" Style="{StaticResource SectionTitle}" />
                            <Border Grid.Column="1" Background="{StaticResource ColorSurfaceHigh}"
                                    StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="8,2"
                                    VerticalOptions="Center">
                                <Label Style="{StaticResource Caption}" FontSize="10">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="v" />
                                            <Span Text="{Binding CurrentVersion}" FontAttributes="Bold"
                                                  TextColor="{StaticResource ColorTextPrimary}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </Border>
                        </Grid>

                        <VerticalStackLayout>
                            <Label Text="Güncelleme Sunucusu (Velopack RELEASES URL)" Style="{StaticResource Caption}" />
                            <Entry Text="{Binding Settings.UpdateServerUrl}"
                                   Placeholder="https://myrobotics.com.tr/updates/inspector/" />
                            <Label Text="Bu URL'deki RELEASES + *.nupkg dosyaları manifest olarak okunur."
                                   FontSize="10" TextColor="{StaticResource ColorTextTertiary}" Margin="0,4,0,0" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Switch Grid.Column="0" IsToggled="{Binding Settings.AutoCheckUpdates}" />
                            <Label Grid.Column="1"
                                   Text="Açılışta arka planda güncellemeleri kontrol et"
                                   Style="{StaticResource BodyText}" VerticalOptions="Center" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Button Grid.Column="0" Text="Şimdi Kontrol Et"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding CheckUpdateCommand}"
                                    IsEnabled="{Binding IsCheckingUpdate, Converter={StaticResource InvertedBool}}" />
                            <ActivityIndicator Grid.Column="1"
                                               IsRunning="{Binding IsCheckingUpdate}"
                                               IsVisible="{Binding IsCheckingUpdate}"
                                               Color="{StaticResource ColorAccent}" VerticalOptions="Center" />
                        </Grid>

                        <!-- Update available -> büyük indir butonu -->
                        <Border Background="{StaticResource ColorSurfaceHigh}" StrokeThickness="0"
                                StrokeShape="RoundRectangle 8" Padding="12"
                                IsVisible="{Binding UpdateAvailable}">
                            <VerticalStackLayout Spacing="8">
                                <Label Style="{StaticResource BodyText}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="🎉 Yeni sürüm: " />
                                            <Span Text="{Binding NewVersion}" FontAttributes="Bold"
                                                  TextColor="{StaticResource ColorSuccess}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Button Text="⬇  İndir ve Yeniden Başlat"
                                        Style="{StaticResource SuccessButton}"
                                        Command="{Binding ApplyUpdateCommand}"
                                        IsEnabled="{Binding IsApplyingUpdate, Converter={StaticResource InvertedBool}}" />
                                <ProgressBar Progress="{Binding UpdateProgress, Converter={StaticResource ProgressNorm}}"
                                             ProgressColor="{StaticResource ColorSuccess}"
                                             IsVisible="{Binding IsApplyingUpdate}" />
                            </VerticalStackLayout>
                        </Border>

                        <Label Text="{Binding UpdateStatus}" Style="{StaticResource Caption}"
                               IsVisible="{Binding UpdateStatus, Converter={StaticResource StringNotEmpty}}" />
                    </VerticalStackLayout>
                </Border>

                <!-- ============== HESAP ============== -->
                <Border Style="{StaticResource CardBorder}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border Grid.Column="0"
                                Background="{StaticResource ColorSurfaceHigh}"
                                StrokeShape="RoundRectangle 22"
                                HeightRequest="44" WidthRequest="44"
                                StrokeThickness="0">
                            <Label Text="👤" FontSize="22"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="GİRİŞ YAPAN" Style="{StaticResource SectionTitle}" />
                            <Label Text="{Binding CurrentProfileName, TargetNullValue='—'}"
                                   Style="{StaticResource CardTitle}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="2" Text="Çıkış Yap"
                                Style="{StaticResource DangerButton}"
                                Padding="16,0" VerticalOptions="Center"
                                Command="{Binding LogoutCommand}" />
                    </Grid>
                </Border>

                <Label Text="{Binding StatusMessage}" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                <BoxView HeightRequest="20" Color="Transparent" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
