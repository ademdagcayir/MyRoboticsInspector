<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MyRoboticsInspector.ViewModels"
             xmlns:m="clr-namespace:MyRoboticsInspector.Models"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             x:Class="MyRoboticsInspector.Pages.ProjectChannelsPage"
             x:DataType="vm:ProjectChannelsViewModel"
             x:Name="PageRoot"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource ColorPageBg}">

    <!--
        3 kolon:
          Col 0 (40px)  — toggle şeridi
          Col 1 (Auto)  — proje bilgi paneli (IsPanelOpen=false → kolapsar)
          Col 2 (*)     — [280px kanal listesi | * stream+panel]
    -->
    <Grid ColumnDefinitions="40,Auto,*" ColumnSpacing="0">

        <!-- ══ COL 0 — Toggle şeridi ══ -->
        <Border Grid.Column="0"
                Background="{StaticResource ColorSurface}"
                Stroke="{StaticResource ColorBorder}" StrokeThickness="0,0,1,0">
            <Button Text="{Binding PanelToggleIcon}"
                    FontSize="14" FontAttributes="Bold"
                    Background="Transparent"
                    TextColor="{StaticResource ColorTextTertiary}"
                    HeightRequest="44" WidthRequest="40" Padding="0"
                    VerticalOptions="Center"
                    Command="{Binding TogglePanelCommand}" />
        </Border>

        <!-- ══ COL 1 — Proje Bilgi Paneli ══ -->
        <Border Grid.Column="1"
                WidthRequest="240"
                Background="{StaticResource ColorSurface}"
                Stroke="{StaticResource ColorBorder}" StrokeThickness="0,0,1,0"
                IsVisible="{Binding IsPanelOpen}">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="0">

                <VerticalStackLayout Grid.Row="0" Padding="16,16,16,0" Spacing="0">
                    <Button Text="‹  Projeler"
                            Style="{StaticResource QuietButton}"
                            HorizontalOptions="Start" Padding="0" FontSize="13"
                            TextColor="{StaticResource ColorAccent}"
                            Command="{Binding BackToProjectsCommand}" />
                    <Label Text="{Binding Project.Title, TargetNullValue='Proje'}"
                           FontSize="17" FontAttributes="Bold"
                           TextColor="{StaticResource ColorTextPrimary}"
                           Margin="0,10,0,4" LineBreakMode="WordWrap" />
                    <BoxView HeightRequest="1" Color="{StaticResource ColorBorder}" Margin="0,12,0,12" />
                </VerticalStackLayout>

                <ScrollView Grid.Row="1" Padding="16,0,16,0">
                    <VerticalStackLayout Spacing="10">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="TARİH" Style="{StaticResource SectionTitle}" />
                            <Label Text="{Binding Project.ProjectDate, StringFormat='{0:dd.MM.yyyy}'}"
                                   FontSize="13" TextColor="{StaticResource ColorTextPrimary}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="2"
                            IsVisible="{Binding Project.Province, Converter={StaticResource StringNotEmpty}}">
                            <Label Text="KONUM" Style="{StaticResource SectionTitle}" />
                            <Label FontSize="12" TextColor="{StaticResource ColorTextPrimary}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding Project.Province}" />
                                        <Span Text=" / " TextColor="{StaticResource ColorTextTertiary}" />
                                        <Span Text="{Binding Project.District}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="GÖRÜNTÜLEME" Style="{StaticResource SectionTitle}" />
                            <Border Padding="6,3" Background="{StaticResource ColorSuccessMuted}"
                                    StrokeShape="RoundRectangle 4" StrokeThickness="0">
                                <Label Text="{Binding Project.Stage, Converter={StaticResource StageLabelConverter}}"
                                       FontSize="11" TextColor="{StaticResource ColorSuccess}" />
                            </Border>
                            <Border Padding="6,3" Background="{StaticResource ColorAccentMuted}"
                                    StrokeShape="RoundRectangle 4" StrokeThickness="0">
                                <Label Text="{Binding Project.Purpose, Converter={StaticResource PurposeLabelConverter}}"
                                       FontSize="11" TextColor="{StaticResource ColorAccent}" />
                            </Border>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Color="{StaticResource ColorBorder}" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <VerticalStackLayout Grid.Column="0" Spacing="1">
                                <Label Text="{Binding TotalChannels}"
                                       FontSize="20" FontAttributes="Bold"
                                       TextColor="{StaticResource ColorHighlight}" />
                                <Label Text="kanal" FontSize="10"
                                       TextColor="{StaticResource ColorTextTertiary}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                <Label Text="{Binding TotalMeters, StringFormat='{0:0.0}'}"
                                       FontSize="20" FontAttributes="Bold"
                                       TextColor="{StaticResource ColorTextPrimary}" />
                                <Label Text="m toplam" FontSize="10"
                                       TextColor="{StaticResource ColorTextTertiary}" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </ScrollView>

                <VerticalStackLayout Grid.Row="2" Spacing="6" Padding="16,12,16,20">
                    <Button Text="+ Yeni Kanal"
                            Style="{StaticResource PrimaryButton}"
                            HeightRequest="36" FontSize="12"
                            Command="{Binding NewChannelCommand}" />
                    <Button Text="Projeyi Düzenle"
                            Style="{StaticResource SecondaryButton}"
                            HeightRequest="32" FontSize="12"
                            Command="{Binding OpenProjectFormCommand}" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- ══ COL 2 — Kanal Listesi + Stream + Paneller ══ -->
        <!-- ChannelList: * (panel açılınca küçülür) | Stream: 960px sabit (hiç değişmez) -->
        <Grid Grid.Column="2" ColumnDefinitions="*,960" ColumnSpacing="0">

            <!-- ── Sol: Modern Kanal Grid'i ── -->
            <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*">

                <!-- Başlık -->
                <Grid Grid.Row="0" Padding="12,10,8,8" ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0"
                           Text="{Binding TotalChannels, StringFormat='KANALLAR ({0})'}"
                           Style="{StaticResource SectionTitle}" VerticalOptions="Center" />
                </Grid>

                <!-- Kolon başlıkları -->
                <Grid Grid.Row="1" Padding="10,6" ColumnSpacing="8"
                      ColumnDefinitions="34,2*,2*,2*,68,80"
                      BackgroundColor="{StaticResource ColorSurfaceSubtle}">
                    <Label Grid.Column="0" Text="No"         Style="{StaticResource SectionTitle}" LineBreakMode="NoWrap" />
                    <Label Grid.Column="1" Text="SOKAK"      Style="{StaticResource SectionTitle}" LineBreakMode="TailTruncation" />
                    <Label Grid.Column="2" Text="GİRİŞ"      Style="{StaticResource SectionTitle}" LineBreakMode="TailTruncation" />
                    <Label Grid.Column="3" Text="ÇIKIŞ"      Style="{StaticResource SectionTitle}" LineBreakMode="TailTruncation" />
                    <Label Grid.Column="4" Text="METRE"      Style="{StaticResource SectionTitle}" LineBreakMode="NoWrap" HorizontalOptions="End" />
                    <Label Grid.Column="5" Text="İŞLEM"      Style="{StaticResource SectionTitle}" LineBreakMode="NoWrap" HorizontalOptions="Center" />
                </Grid>
                <BoxView Grid.Row="1" VerticalOptions="End" HeightRequest="1"
                         Color="{StaticResource ColorBorder}" />

                <CollectionView Grid.Row="2" ItemsSource="{Binding Channels}" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center"
                                             Spacing="8" Padding="20">
                            <Label Text="Kanal yok" FontSize="13" FontAttributes="Bold"
                                   TextColor="{StaticResource ColorTextPrimary}" HorizontalOptions="Center" />
                            <Label Text="+ Yeni Kanal ile ekleyin"
                                   FontSize="11" TextColor="{StaticResource ColorTextTertiary}"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChannelListItem">
                            <Grid Padding="10,0" HeightRequest="46"
                                  ColumnDefinitions="34,2*,2*,2*,68,80" ColumnSpacing="8"
                                  BackgroundColor="{Binding IsSelected, Converter={StaticResource BoolToHighlightColor}}">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.SelectChannelCommand}"
                                        CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>

                                <!-- Sağ tık menüsü -->
                                <FlyoutBase.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Kanalı düzenle"
                                            Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.EditCommand}"
                                            CommandParameter="{Binding .}" />
                                        <MenuFlyoutItem Text="Klasörü aç"
                                            Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.OpenChannelFolderCommand}"
                                            CommandParameter="{Binding .}" />
                                        <MenuFlyoutItem Text="Rapor oluştur (2 PDF)"
                                            Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.GenerateReportsCommand}"
                                            CommandParameter="{Binding .}" />
                                    </MenuFlyout>
                                </FlyoutBase.ContextFlyout>

                                <!-- No: durum noktası + sıra numarası rozeti -->
                                <Grid Grid.Column="0" ColumnDefinitions="Auto,Auto" ColumnSpacing="4"
                                      VerticalOptions="Center" HorizontalOptions="Start">
                                    <Ellipse Grid.Column="0" Fill="{Binding StatusColor}"
                                             WidthRequest="6" HeightRequest="6" VerticalOptions="Center" />
                                    <Border Grid.Column="1" WidthRequest="22" HeightRequest="22"
                                            Background="{StaticResource ColorSurfaceSubtle}"
                                            Stroke="{StaticResource ColorBorder}" StrokeThickness="1"
                                            StrokeShape="RoundRectangle 6" Padding="0"
                                            VerticalOptions="Center">
                                        <Label Text="{Binding NumberBadge}"
                                               FontSize="11" FontAttributes="Bold"
                                               TextColor="{StaticResource ColorHighlight}"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                </Grid>

                                <Label Grid.Column="1" Text="{Binding StreetText}"
                                       FontSize="12" FontAttributes="Bold"
                                       TextColor="{StaticResource ColorTextPrimary}"
                                       VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                <Label Grid.Column="2" Text="{Binding EntryText}"
                                       FontSize="12" TextColor="{StaticResource ColorTextSecondary}"
                                       VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                <Label Grid.Column="3" Text="{Binding ExitText}"
                                       FontSize="12" TextColor="{StaticResource ColorTextSecondary}"
                                       VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                <Label Grid.Column="4" Text="{Binding MetersText}"
                                       FontSize="12" TextColor="{StaticResource ColorTextPrimary}"
                                       VerticalOptions="Center" HorizontalOptions="End" />

                                <!-- İşlem: oynat / düzenle / sil -->
                                <HorizontalStackLayout Grid.Column="5" Spacing="0"
                                                       HorizontalOptions="End" VerticalOptions="Center">
                                    <Button Text="▶" FontSize="11"
                                            Background="Transparent"
                                            TextColor="{StaticResource ColorAccent}"
                                            HeightRequest="40" WidthRequest="24" Padding="0"
                                            IsVisible="{Binding HasVideo}"
                                            Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.PlayVideoCommand}"
                                            CommandParameter="{Binding .}" />
                                    <Button Text="✎" FontSize="11"
                                            Background="Transparent"
                                            TextColor="{StaticResource ColorTextSecondary}"
                                            HeightRequest="40" WidthRequest="24" Padding="0"
                                            Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.EditCommand}"
                                            CommandParameter="{Binding .}" />
                                    <Button Text="✕" FontSize="11"
                                            Background="Transparent" TextColor="#777"
                                            HeightRequest="40" WidthRequest="24" Padding="0"
                                            Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.DeleteCommand}"
                                            CommandParameter="{Binding .}" />
                                </HorizontalStackLayout>

                                <BoxView Grid.ColumnSpan="6" VerticalOptions="End"
                                         HeightRequest="1" Color="{StaticResource ColorBorder}" Opacity="0.4" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
            <BoxView Grid.Column="0" HorizontalOptions="End" WidthRequest="1"
                     Color="{StaticResource ColorBorder}" />

            <!-- ── Sağ: Stream + Kontrol Panelleri ── -->
            <Grid Grid.Column="1"
                  RowDefinitions="*,Auto,170"
                  RowSpacing="0"
                  x:DataType="vm:ProjectChannelsViewModel">

                <!-- ════ ROW 0: Canlı görüntü + overlay ════ -->
                <Border Grid.Row="0" Background="Black"
                        Stroke="{StaticResource ColorBorder}" StrokeThickness="0">
                    <Grid>
                        <!-- Canlı: SkiaSharp composite kare (proje/baca/metre overlay'i SENKRON gömülü) -->
                        <skia:SKCanvasView x:Name="ChannelCanvas"
                                           IsVisible="{Binding Live.HasLiveFrame}" />

                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8"
                                             IsVisible="{Binding Live.HasLiveFrame, Converter={StaticResource InvertedBool}}">
                            <Label Text="📹" FontSize="40" HorizontalOptions="Center" />
                            <Label Text="Kamera bekleniyor" TextColor="#888" FontSize="14" HorizontalOptions="Center" />
                            <Label Text="Ayarlar → RTSP adresini girin" TextColor="#555" FontSize="11" HorizontalOptions="Center" />
                        </VerticalStackLayout>

                        <!-- Hafif operasyonel overlay: seçili kanal + REC.
                             Proje/baca/metre/saat artık composite kareye SENKRON gömülü. -->
                        <Grid Padding="14" InputTransparent="True"
                              ColumnDefinitions="*,Auto"
                              IsVisible="{Binding Live.HasLiveFrame}">
                            <VerticalStackLayout Grid.Column="0" Spacing="2"
                                                 HorizontalOptions="Start" VerticalOptions="Start">
                                <Label Text="{Binding SelectedChannelLabel}"
                                       TextColor="{StaticResource ColorHighlight}"
                                       FontSize="15" FontAttributes="Bold" />
                                <Label Text="{Binding SelectedChannelFlow}"
                                       TextColor="White" FontSize="11"
                                       IsVisible="{Binding SelectedChannelFlow, Converter={StaticResource StringNotEmpty}}" />
                            </VerticalStackLayout>
                            <!-- Kayıt göstergesi: yanıp sönen kırmızı nokta (yazı yok) -->
                            <Ellipse Grid.Column="1" x:Name="RecDot"
                                     WidthRequest="14" HeightRequest="14"
                                     Fill="#ff453a"
                                     HorizontalOptions="End" VerticalOptions="Start"
                                     IsVisible="{Binding Live.IsRecording}" />
                        </Grid>

                        <!-- BASINÇ BARI — stream'in altında, pil tarzı (≥60 yeşil / 40-60 turuncu / <40 kırmızı) -->
                        <Border VerticalOptions="End" Margin="16" Padding="14,9" InputTransparent="True"
                                BackgroundColor="#B0000000" StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                IsVisible="{Binding Live.HasLiveFrame}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                                <Label Grid.Column="0" Text="Basınç" TextColor="#D6D9E0" FontSize="13" VerticalOptions="Center" />
                                <Border Grid.Column="1" VerticalOptions="Center" HeightRequest="18"
                                        BackgroundColor="#33FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 9">
                                    <ProgressBar Progress="{Binding Live.Telemetry.PressureFill}"
                                                 ProgressColor="{Binding Live.Telemetry.PressureBarColor}"
                                                 HeightRequest="18" VerticalOptions="Center" BackgroundColor="Transparent" />
                                </Border>
                                <Label Grid.Column="2" FontAttributes="Bold" FontSize="15" VerticalOptions="Center"
                                       TextColor="{Binding Live.Telemetry.PressureBarColor}"
                                       Text="{Binding Live.Telemetry.PressurePercent, StringFormat='{0:0}%', TargetNullValue='—'}" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- ════ ROW 1: Apple Toolbar ════ -->
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" BackgroundColor="{StaticResource ColorSurfaceHigh}"
                      Margin="0" Padding="0">
                    <!-- üst çizgi -->
                    <BoxView Grid.ColumnSpan="2" VerticalOptions="Start" HeightRequest="1" Color="{StaticResource ColorBorder}" />

                    <!-- Sol: aksiyon butonları -->
                    <HorizontalStackLayout Grid.Column="0" Spacing="8"
                                           Padding="16,8,0,8" VerticalOptions="Center">
                        <Label Text="{Binding SelectedChannelLabel}"
                               FontSize="12" TextColor="{StaticResource ColorTextSecondary}" VerticalOptions="Center" />
                        <BoxView WidthRequest="1" HeightRequest="16" Color="{StaticResource ColorBorder}" VerticalOptions="Center" />
                        <Button Text="📷"
                                BackgroundColor="{StaticResource ColorSurfaceSubtle}" TextColor="{StaticResource ColorTextPrimary}" FontSize="22"
                                CornerRadius="12"
                                HeightRequest="44" WidthRequest="58" Padding="0"
                                ToolTipProperties.Text="Fotoğraf çek ve yorum ekle"
                                Command="{Binding CapturePhotoCommand}" />
                        <Button Text="{Binding RecordButtonText}"
                                BackgroundColor="{Binding RecordButtonColor}"
                                TextColor="White" CornerRadius="12"
                                FontSize="12" FontAttributes="Bold"
                                HeightRequest="28" Padding="14,0"
                                IsEnabled="{Binding CanStartRecording}"
                                Command="{Binding StartChannelRecordingCommand}" />
                        <Button Text="Kanal Sonu"
                                BackgroundColor="{StaticResource ColorSurfaceSubtle}" TextColor="{StaticResource ColorTextSecondary}"
                                CornerRadius="12" FontSize="12"
                                HeightRequest="28" Padding="12,0"
                                IsEnabled="{Binding Live.IsRecording}"
                                Command="{Binding KanalSonuCommand}" />
                    </HorizontalStackLayout>

                    <!-- Sağ: durum + yayın toggle -->
                    <HorizontalStackLayout Grid.Column="1" Spacing="4"
                                           Padding="0,8,12,8" VerticalOptions="Center">
                        <Label Text="{Binding Live.StatusMessage}"
                               FontSize="11" TextColor="{StaticResource ColorTextTertiary}"
                               VerticalOptions="Center" MaximumWidthRequest="200"
                               LineBreakMode="TailTruncation" />
                        <Button Text="▶"
                                BackgroundColor="Transparent" TextColor="{StaticResource ColorTextSecondary}"
                                FontSize="13" HeightRequest="32" WidthRequest="30" Padding="0"
                                Command="{Binding Live.StartStreamCommand}"
                                IsVisible="{Binding Live.IsStreaming, Converter={StaticResource InvertedBool}}" />
                        <Button Text="⏹"
                                BackgroundColor="Transparent" TextColor="{StaticResource ColorTextSecondary}"
                                FontSize="13" HeightRequest="32" WidthRequest="30" Padding="0"
                                Command="{Binding Live.StopStreamCommand}"
                                IsVisible="{Binding Live.IsStreaming}" />
                    </HorizontalStackLayout>
                </Grid>

                <!-- ════ ROW 2: Alt paneller — Arıza Resimleri | MQTT ════ -->
                <Grid Grid.Row="2"
                      ColumnDefinitions="*,220"
                      ColumnSpacing="0"
                      Background="{StaticResource ColorSurface}">

                    <BoxView Grid.ColumnSpan="2" VerticalOptions="Start" HeightRequest="1"
                             Color="{StaticResource ColorBorder}" />

                    <!-- ── Sol: Arıza / Kusur Resimleri ── -->
                    <Grid Grid.Column="0" RowDefinitions="Auto,*" Padding="12,8,8,8">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                            <Label Grid.Column="0"
                                   Text="{Binding ChannelPhotos.Count, StringFormat='FOTOĞRAFLAR ({0})'}"
                                   FontSize="10" FontAttributes="Bold" CharacterSpacing="0.5"
                                   TextColor="{StaticResource ColorTextSecondary}" VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="{Binding SelectedChannelLabel}"
                                   FontSize="10" TextColor="{StaticResource ColorTextTertiary}"
                                   VerticalOptions="Center" />
                        </Grid>

                        <!-- Yatay scroll — fotoğraf thumbnail kartları (tıkla → yorumu düzenle).
                             Scrollbar görünür: çok foto olunca eski kareler kaydırılarak görülebilir. -->
                        <ScrollView Grid.Row="1" Orientation="Horizontal"
                                    HorizontalScrollBarVisibility="Always">
                            <HorizontalStackLayout Spacing="8"
                                                   BindableLayout.ItemsSource="{Binding ChannelPhotos}">
                                <BindableLayout.EmptyView>
                                    <Label Text="📷 Henüz fotoğraf yok — kamera ile çekin"
                                           FontSize="11"
                                           TextColor="{StaticResource ColorTextTertiary}"
                                           VerticalOptions="Center" HorizontalOptions="Center"
                                           Margin="8,0" />
                                </BindableLayout.EmptyView>
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="m:Defect">
                                        <Border WidthRequest="96"
                                                Background="{StaticResource ColorSurfaceHigh}"
                                                Stroke="{StaticResource ColorBorder}"
                                                StrokeThickness="1"
                                                StrokeShape="RoundRectangle 8"
                                                Padding="0">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.EditPhotoCommentCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Grid>
                                                <VerticalStackLayout Spacing="0">
                                                    <!-- Thumbnail -->
                                                    <Image Source="{Binding PhotoPath}"
                                                           HeightRequest="62" WidthRequest="96"
                                                           Aspect="AspectFill"
                                                           BackgroundColor="{StaticResource ColorSurfaceSubtle}" />
                                                    <!-- Yorum + meta -->
                                                    <VerticalStackLayout Padding="6,4,6,6" Spacing="2">
                                                        <Label Text="{Binding Description, TargetNullValue='(yorum yok)'}"
                                                               FontSize="10" FontAttributes="Bold"
                                                               TextColor="{StaticResource ColorTextPrimary}"
                                                               MaxLines="2"
                                                               LineBreakMode="TailTruncation" />
                                                        <Label FontSize="9" TextColor="{StaticResource ColorTextTertiary}">
                                                            <Label.FormattedText>
                                                                <FormattedString>
                                                                    <Span Text="{Binding DistanceMeters, StringFormat='{0:0.0} m  ·  ', TargetNullValue=''}" />
                                                                    <Span Text="{Binding CreatedAt, StringFormat='{0:HH:mm}'}" />
                                                                </FormattedString>
                                                            </Label.FormattedText>
                                                        </Label>
                                                    </VerticalStackLayout>
                                                </VerticalStackLayout>

                                                <!-- Sil butonu (sağ üst) -->
                                                <Button Text="✕" FontSize="10"
                                                        BackgroundColor="#cc000000" TextColor="White"
                                                        CornerRadius="10" Padding="0"
                                                        HeightRequest="20" WidthRequest="20"
                                                        HorizontalOptions="End" VerticalOptions="Start"
                                                        Margin="0,3,3,0"
                                                        Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.DeletePhotoCommand}"
                                                        CommandParameter="{Binding .}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </ScrollView>
                    </Grid>

                    <!-- Dikey ayırıcı -->
                    <BoxView Grid.Column="0" HorizontalOptions="End" WidthRequest="1"
                             Color="{StaticResource ColorBorder}" />

                    <!-- ── Sağ: MQTT Broker Paneli ── -->
                    <Grid Grid.Column="1" RowDefinitions="Auto,*" Padding="10,8,10,8" RowSpacing="6">

                        <!-- Başlık + bağlantı durumu -->
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="BROKER"
                                   FontSize="10" FontAttributes="Bold" CharacterSpacing="0.5"
                                   TextColor="{StaticResource ColorTextSecondary}" VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="{Binding Live.IsRobotConnected, Converter={StaticResource BoolToConnectionText}}"
                                   FontSize="10"
                                   TextColor="{Binding Live.IsRobotConnected, Converter={StaticResource BoolToConnectionColor}}"
                                   VerticalOptions="Center" />
                        </Grid>

                        <!-- MQTT log — TEK-METİN terminal (en yeni üstte, MainPage'deki desen).
                             Not: Eski MqttLog koleksiyonu hiç doldurulmuyordu (ölü binding) —
                             trafik MqttConsoleText tamponuna akar, panel artık onu gösterir. -->
                        <Border Grid.Row="1"
                                Background="{StaticResource ColorSurfaceSubtle}" StrokeThickness="1"
                                Stroke="{StaticResource ColorBorder}"
                                StrokeShape="RoundRectangle 8"
                                Padding="0">
                            <Grid>
                                <ScrollView VerticalScrollBarVisibility="Always" Padding="8,4">
                                    <Label Text="{Binding Live.MqttConsoleText}"
                                           FontSize="9" TextColor="{StaticResource ColorTextSecondary}"
                                           LineBreakMode="NoWrap" />
                                </ScrollView>
                                <!-- Boş durum: henüz hiç trafik yoksa -->
                                <Label Text="Bağlantı bekleniyor" TextColor="{StaticResource ColorTextTertiary}" FontSize="10"
                                       HorizontalOptions="Center" VerticalOptions="Start" Margin="0,10"
                                       IsVisible="False">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding Live.MqttConsoleText}" Value="">
                                            <Setter Property="IsVisible" Value="True" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Grid>
                        </Border>
                    </Grid>

                </Grid>
                <!-- ════ END ROW 2 ════ -->

            </Grid>
            <!-- END stream area -->

        </Grid>
        <!-- END col 2 -->

    </Grid>
</ContentPage>
