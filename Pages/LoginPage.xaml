<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MyRoboticsInspector.ViewModels"
             xmlns:m="clr-namespace:MyRoboticsInspector.Models"
             x:Class="MyRoboticsInspector.Pages.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="MyRoboticsInspector"
             BackgroundColor="{StaticResource ColorPageBg}">

    <Grid Padding="40">
        <ScrollView>
            <VerticalStackLayout Spacing="24" MaximumWidthRequest="480" HorizontalOptions="Center" VerticalOptions="Center">

                <!-- Hero / branding -->
                <VerticalStackLayout Spacing="4" Margin="0,0,0,16">
                    <Label Text="🛰️" FontSize="48" HorizontalOptions="Center" />
                    <Label Text="My Robotics" FontSize="32" FontAttributes="Bold"
                           TextColor="{StaticResource ColorTextPrimary}" HorizontalOptions="Center" />
                    <Label Text="Kanal Görüntüleme Sistemi" FontSize="13"
                           TextColor="{StaticResource ColorTextSecondary}" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- ============== PROFILE PICKER MODE ============== -->
                <VerticalStackLayout Spacing="12" IsVisible="{Binding IsCreating, Converter={StaticResource InvertedBool}}">

                    <Label Text="PROFİL SEÇ" Style="{StaticResource SectionTitle}" HorizontalOptions="Center" />

                    <CollectionView ItemsSource="{Binding Profiles}"
                                    SelectedItem="{Binding SelectedProfile}"
                                    SelectionMode="Single"
                                    MaximumHeightRequest="320">
                        <CollectionView.EmptyView>
                            <Label Text="Henüz profil yok"
                                   Style="{StaticResource Caption}" HorizontalOptions="Center" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="m:Profile">
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border Grid.Column="0"
                                                Background="{StaticResource ColorSurfaceHigh}"
                                                StrokeShape="RoundRectangle 24"
                                                HeightRequest="48" WidthRequest="48"
                                                StrokeThickness="0">
                                            <Label Text="👤" FontSize="22"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Name}" Style="{StaticResource CardTitle}" />
                                            <Label Text="{Binding Email}" Style="{StaticResource Caption}"
                                                   IsVisible="{Binding Email, Converter={StaticResource StringNotEmpty}}" />
                                            <Label Text="🔒 PIN korumalı" FontSize="10"
                                                   TextColor="{StaticResource ColorWarning}"
                                                   IsVisible="{Binding Pin, Converter={StaticResource StringNotEmpty}}" />
                                        </VerticalStackLayout>
                                        <Button Grid.Column="2" Text="🗑"
                                                Style="{StaticResource QuietButton}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LoginViewModel}}, Path=DeleteCommand}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Entry Text="{Binding PinInput}" Placeholder="PIN"
                           Keyboard="Numeric" IsPassword="True" MaxLength="6"
                           IsVisible="{Binding NeedsPin}" />

                    <Button Text="Giriş Yap"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding LoginCommand}"
                            IsEnabled="{Binding HasProfiles}" />

                    <Button Text="+ Yeni Profil Oluştur"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ShowCreateCommand}" />
                </VerticalStackLayout>

                <!-- ============== CREATE MODE ============== -->
                <VerticalStackLayout Spacing="12" IsVisible="{Binding IsCreating}">
                    <Label Text="YENİ PROFİL" Style="{StaticResource SectionTitle}" HorizontalOptions="Center" />

                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="10">
                            <VerticalStackLayout>
                                <Label Text="Ad Soyad" Style="{StaticResource Caption}" />
                                <Entry Text="{Binding NewName}" Placeholder="örn. Adem Dağcayır" />
                            </VerticalStackLayout>
                            <VerticalStackLayout>
                                <Label Text="E-posta (opsiyonel)" Style="{StaticResource Caption}" />
                                <Entry Text="{Binding NewEmail}" Placeholder="ornek@firma.com" Keyboard="Email" />
                            </VerticalStackLayout>
                            <VerticalStackLayout>
                                <Label Text="PIN (4-6 rakam, opsiyonel)" Style="{StaticResource Caption}" />
                                <Entry Text="{Binding NewPin}" Placeholder="1234"
                                       Keyboard="Numeric" IsPassword="True" MaxLength="6" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Grid.Column="0" Text="İptal"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding CancelCreateCommand}"
                                IsVisible="{Binding HasProfiles}" />
                        <Button Grid.Column="1" Text="✓ Oluştur"
                                Style="{StaticResource SuccessButton}"
                                Command="{Binding CreateCommand}" />
                    </Grid>
                </VerticalStackLayout>

                <Label Text="{Binding ErrorMessage}"
                       TextColor="{StaticResource ColorDanger}"
                       FontSize="13" FontAttributes="Bold"
                       HorizontalOptions="Center" HorizontalTextAlignment="Center"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmpty}}" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
