<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MyRoboticsInspector.ViewModels"
             xmlns:m="clr-namespace:MyRoboticsInspector.Models"
             x:Class="MyRoboticsInspector.Pages.InspectionReviewPage"
             x:DataType="vm:InspectionReviewViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource ColorPageBg}">

    <Grid Padding="12" RowDefinitions="*,Auto,Auto" ColumnDefinitions="*,300" ColumnSpacing="12" RowSpacing="10">

        <!-- ============== VIDEO ============== -->
        <Border Grid.Row="0" Grid.Column="0"
                Stroke="{StaticResource ColorBorder}" StrokeThickness="1"
                Background="#111318" StrokeShape="RoundRectangle 10">
            <Grid>
                <!-- Kayıt VAR — dosya bilgisi + oynat butonu -->
                <VerticalStackLayout IsVisible="{Binding HasVideo}"
                                     VerticalOptions="Center" HorizontalOptions="Center"
                                     Spacing="16" Padding="32">
                    <Label Text="🎬" FontSize="56" HorizontalOptions="Center" />
                    <Label Text="{Binding VideoFileName}"
                           FontSize="16" FontAttributes="Bold"
                           TextColor="{StaticResource ColorTextPrimary}"
                           HorizontalOptions="Center"
                           LineBreakMode="MiddleTruncation" MaxLines="2" />
                    <Label Text="{Binding VideoFileSize}"
                           Style="{StaticResource Caption}"
                           HorizontalOptions="Center" />
                    <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Button Text="▶  Oynat"
                                Style="{StaticResource PrimaryButton}"
                                Padding="28,10"
                                FontSize="15"
                                Command="{Binding OpenVideoCommand}" />
                        <Button Text="📁 Klasör"
                                Style="{StaticResource SecondaryButton}"
                                Padding="16,10"
                                Command="{Binding OpenFolderCommand}" />
                    </HorizontalStackLayout>
                    <Label Text="Sistem varsayılan oynatıcısında açılır (VLC, WMP vb.)"
                           Style="{StaticResource Caption}"
                           HorizontalOptions="Center"
                           Opacity="0.5" />
                </VerticalStackLayout>

                <!-- Kayıt YOK -->
                <VerticalStackLayout IsVisible="{Binding HasVideo, Converter={StaticResource InvertedBool}}"
                                     VerticalOptions="Center" HorizontalOptions="Center"
                                     Spacing="8">
                    <Label Text="📂" FontSize="40" HorizontalOptions="Center" Opacity="0.4" />
                    <Label Text="Kayıt dosyası bulunamadı"
                           TextColor="{StaticResource ColorTextTertiary}"
                           HorizontalOptions="Center" FontSize="14" />
                    <Label Text="{Binding VideoPath}"
                           Style="{StaticResource Caption}"
                           HorizontalOptions="Center"
                           IsVisible="{Binding VideoPath, Converter={StaticResource StringNotEmpty}}"
                           LineBreakMode="CharacterWrap" MaxLines="2"
                           Opacity="0.4" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- ============== DEFECT LIST ============== -->
        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardBorder}">
            <VerticalStackLayout Spacing="6">
                <Label Text="KUSURLAR" Style="{StaticResource SectionTitle}" />
                <CollectionView ItemsSource="{Binding Defects}" SelectedItem="{Binding SelectedDefect}"
                                SelectionMode="Single">
                    <CollectionView.EmptyView>
                        <Label Text="(kusur yok)" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="m:Defect">
                            <Border Padding="8" Margin="0,0,0,4"
                                    Stroke="{StaticResource ColorBorder}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 6"
                                    Background="{StaticResource ColorSurfaceHigh}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:InspectionReviewViewModel}}, Path=SeekToCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="60,*" ColumnSpacing="8">
                                    <Image Grid.Column="0" Source="{Binding PhotoPath}"
                                           HeightRequest="44" WidthRequest="60"
                                           Aspect="AspectFill" BackgroundColor="{StaticResource ColorSurfaceHigh}" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label FontSize="12" FontAttributes="Bold"
                                               TextColor="{StaticResource ColorTextPrimary}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding IskiCode, TargetNullValue=''}"
                                                          TextColor="{StaticResource ColorWarning}" />
                                                    <Span Text=" " />
                                                    <Span Text="{Binding Severity}" />
                                                    <Span Text=" • " TextColor="{StaticResource ColorTextTertiary}" />
                                                    <Span Text="{Binding Type}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <Label Style="{StaticResource Caption}" FontSize="10">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding DistanceMeters, StringFormat='{0:0.0} m', TargetNullValue='— m'}" />
                                                    <Span Text="  •  " TextColor="{StaticResource ColorTextTertiary}" />
                                                    <Span Text="{Binding VideoTimestampMs, Converter={StaticResource MsToTimestamp}}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Border>

        <!-- ============== SCRUBBER + MARKERS (sadece kayıt varken göster) ============== -->
        <Grid Grid.Row="1" Grid.ColumnSpan="2" IsVisible="{Binding HasVideo}">
            <Grid HeightRequest="14" Margin="6,0,6,28">
                <AbsoluteLayout BindableLayout.ItemsSource="{Binding Markers}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:DefectMarker">
                            <BoxView Color="{Binding Color}"
                                     WidthRequest="3" HeightRequest="14"
                                     AbsoluteLayout.LayoutBounds="{Binding XProportion, StringFormat='{}{0},0,3,14'}"
                                     AbsoluteLayout.LayoutFlags="XProportional">
                                <BoxView.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:InspectionReviewViewModel}}, Path=SeekToCommand}"
                                        CommandParameter="{Binding .}" />
                                </BoxView.GestureRecognizers>
                            </BoxView>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </AbsoluteLayout>
            </Grid>
            <Slider Minimum="0" Maximum="{Binding TotalLengthMs}"
                    Value="{Binding CurrentTimeMs, Mode=TwoWay}"
                    MinimumTrackColor="{StaticResource ColorWarning}"
                    MaximumTrackColor="{StaticResource ColorBorder}"
                    ThumbColor="{StaticResource ColorWarning}"
                    VerticalOptions="End" Margin="0,14,0,0" />
        </Grid>

        <!-- ============== TRANSPORT ============== -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource CardBorder}" Padding="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label Grid.Column="0" Text="{Binding StatusMessage}"
                       Style="{StaticResource Caption}" VerticalOptions="Center" />
                <HorizontalStackLayout Grid.Column="1" Spacing="8">
                    <Button Text="▶  Dış Oynatıcıda Aç"
                            Style="{StaticResource PrimaryButton}" Padding="20,0"
                            IsVisible="{Binding HasVideo}"
                            Command="{Binding OpenVideoCommand}" />
                    <Button Text="📁 Klasörü Aç"
                            Style="{StaticResource SecondaryButton}" Padding="14,0"
                            IsVisible="{Binding HasVideo}"
                            Command="{Binding OpenFolderCommand}" />
                </HorizontalStackLayout>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
