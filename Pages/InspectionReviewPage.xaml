<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.MAUI;assembly=LibVLCSharp.MAUI"
             xmlns:vm="clr-namespace:MyRoboticsInspector.ViewModels"
             xmlns:m="clr-namespace:MyRoboticsInspector.Models"
             x:Class="MyRoboticsInspector.Pages.InspectionReviewPage"
             x:DataType="vm:InspectionReviewViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource ColorPageBg}">

    <Grid Padding="12" RowDefinitions="*,Auto,Auto" ColumnDefinitions="*,300" ColumnSpacing="12" RowSpacing="10">

        <!-- ============== VIDEO ============== -->
        <Border Grid.Row="0" Grid.Column="0"
                Stroke="{StaticResource ColorBorder}" StrokeThickness="1"
                Background="Black" StrokeShape="RoundRectangle 10">
            <Grid>
                <vlc:VideoView x:Name="VideoView" MediaPlayer="{Binding MediaPlayer}" />
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8"
                                     IsVisible="{Binding HasVideo, Converter={StaticResource InvertedBool}}">
                    <Label Text="🎬" FontSize="40" HorizontalOptions="Center" Opacity="0.5" />
                    <Label Text="Kayıt bulunamadı"
                           TextColor="{StaticResource ColorTextTertiary}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- ============== DEFECT LIST ============== -->
        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardBorder}">
            <VerticalStackLayout Spacing="6">
                <Label Text="KUSURLAR" Style="{StaticResource SectionTitle}" />
                <CollectionView ItemsSource="{Binding Defects}" SelectedItem="{Binding SelectedDefect}"
                                SelectionMode="Single">
                    <CollectionView.EmptyView>
                        <Label Text="(kusur yok)" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="m:Defect">
                            <Border Padding="8" Margin="0,0,0,4"
                                    Stroke="{StaticResource ColorBorder}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 6"
                                    Background="{StaticResource ColorSurfaceHigh}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:InspectionReviewViewModel}}, Path=SeekToCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="60,*" ColumnSpacing="8">
                                    <Image Grid.Column="0" Source="{Binding PhotoPath}"
                                           HeightRequest="44" WidthRequest="60"
                                           Aspect="AspectFill" BackgroundColor="{StaticResource ColorSurfaceHigh}" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label FontSize="12" FontAttributes="Bold"
                                               TextColor="{StaticResource ColorTextPrimary}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding IskiCode, TargetNullValue=''}"
                                                          TextColor="{StaticResource ColorWarning}" />
                                                    <Span Text=" " />
                                                    <Span Text="{Binding Severity}" />
                                                    <Span Text=" • " TextColor="{StaticResource ColorTextTertiary}" />
                                                    <Span Text="{Binding Type}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <Label Style="{StaticResource Caption}" FontSize="10">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding DistanceMeters, StringFormat='{0:0.0} m', TargetNullValue='— m'}" />
                                                    <Span Text="  •  " TextColor="{StaticResource ColorTextTertiary}" />
                                                    <Span Text="{Binding VideoTimestampMs, Converter={StaticResource MsToTimestamp}}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Border>

        <!-- ============== SCRUBBER + MARKERS ============== -->
        <Grid Grid.Row="1" Grid.ColumnSpan="2">
            <Grid HeightRequest="14" Margin="6,0,6,28">
                <AbsoluteLayout BindableLayout.ItemsSource="{Binding Markers}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:DefectMarker">
                            <BoxView Color="{Binding Color}"
                                     WidthRequest="3" HeightRequest="14"
                                     AbsoluteLayout.LayoutBounds="{Binding XProportion, StringFormat='{}{0},0,3,14'}"
                                     AbsoluteLayout.LayoutFlags="XProportional">
                                <BoxView.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:InspectionReviewViewModel}}, Path=SeekToCommand}"
                                        CommandParameter="{Binding .}" />
                                </BoxView.GestureRecognizers>
                            </BoxView>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </AbsoluteLayout>
            </Grid>
            <Slider Minimum="0" Maximum="{Binding TotalLengthMs}"
                    Value="{Binding CurrentTimeMs, Mode=TwoWay}"
                    MinimumTrackColor="{StaticResource ColorWarning}"
                    MaximumTrackColor="{StaticResource ColorBorder}"
                    ThumbColor="{StaticResource ColorWarning}"
                    VerticalOptions="End" Margin="0,14,0,0" />
        </Grid>

        <!-- ============== TRANSPORT ============== -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource CardBorder}" Padding="12">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
                <Button Grid.Column="0" Text="⏪ 5s"
                        Style="{StaticResource SecondaryButton}" Padding="16,0"
                        Command="{Binding SkipBackwardCommand}" />
                <Button Grid.Column="1" Text="{Binding IsPlaying, Converter={StaticResource BoolToPlayPauseText}}"
                        Style="{StaticResource PrimaryButton}" Padding="24,0" FontAttributes="Bold"
                        Command="{Binding TogglePlayPauseCommand}" />
                <Button Grid.Column="2" Text="5s ⏩"
                        Style="{StaticResource SecondaryButton}" Padding="16,0"
                        Command="{Binding SkipForwardCommand}" />
                <Label Grid.Column="3" VerticalOptions="Center" HorizontalOptions="Center"
                       TextColor="{StaticResource ColorTextPrimary}" FontSize="16">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding CurrentTimeDisplay}" FontAttributes="Bold" />
                            <Span Text="  /  " TextColor="{StaticResource ColorTextTertiary}" />
                            <Span Text="{Binding TotalTimeDisplay}" TextColor="{StaticResource ColorTextSecondary}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Label Grid.Column="4" Text="{Binding StatusMessage}"
                       Style="{StaticResource Caption}" VerticalOptions="Center" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
